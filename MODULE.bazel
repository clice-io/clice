module(name = "clice")

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_pkg", version = "1.3.0")

# `bazel run @compdb//:refresh` writes compile_commands.json.
bazel_dep(name = "compdb", version = "0.1.0")

# kotatsu and the third-party libraries, as the clice Bazel registry
# (bazel/clice.bazelrc) packages them. kotatsu's version is 0.1.0.<n> for the
# n-th commit of its main.
bazel_dep(name = "kotatsu", version = "0.1.0.284")
# kotatsu's, raised to the first version that builds for musl.
bazel_dep(name = "cpptrace", version = "1.0.4.clice.3")
bazel_dep(name = "croaring", version = "5.5.5.clice.1")
bazel_dep(name = "lmdb", version = "0.9.36.clice.1")
# mimalloc 2: on 3 clice was faster still, but held about twice glibc's
# memory once idle.
bazel_dep(name = "mimalloc", version = "2.5.3.clice.2")
bazel_dep(name = "simdjson", version = "5.1.1.clice.1")

# The C++ toolchain on every platform and the LLVM/Clang libraries clice
# links, both from one xclang release: libclang's ThinLTO bitcode needs the
# lld of the same LLVM. pixi.toml pins the same release for the tools the
# tests and the package checks run.
bazel_dep(name = "xclang", version = "23.1.5.3")

xclang = use_extension("@xclang//bazel:extensions.bzl", "xclang")
use_repo(xclang, "libclang")

# CI builds the macOS targets on Linux, and tools/modules/modules.ts generates
# their configurations of modules/ there, against Apple's SDK, which a build
# fetches only for a macOS target off a macOS host.
xclang.macos_sdk(accept_license = True)
