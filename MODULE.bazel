module(name = "clice")

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

# Windows names for MinGW executables and DLLs in rules_cc's Unix toolchain
# config (toolchain/xclang.bzl); not upstream yet.
single_version_override(
    module_name = "rules_cc",
    patch_strip = 1,
    patches = ["//toolchain:rules_cc-mingw-artifacts.patch"],
)

bazel_dep(name = "kotatsu", version = "0.1.0")
local_path_override(
    module_name = "kotatsu",
    path = "../kotatsu-bazel",
)

# The libraries kotatsu builds on are its extension's repos, so that clice
# links the same copy.
kotatsu_deps = use_extension("@kotatsu//bazel:extensions.bzl", "kotatsu_deps")
use_repo(kotatsu_deps, "simdjson")

# From the Bazel Central Registry, at the versions cmake/package.cmake pins.
bazel_dep(name = "zlib", version = "1.3.1.bcr.5")
bazel_dep(name = "zstd", version = "1.5.7")

# Sources whose configuration or version the registry does not offer, each
# with a BUILD file of its own.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "mimalloc",
    build_file = "//third_party:mimalloc.BUILD",
    sha256 = "3b4a15153a59905995f7070296ed604bb5ccc00cabb8b93446931aff77224d47",
    strip_prefix = "mimalloc-3.5.3",
    urls = ["https://github.com/microsoft/mimalloc/archive/refs/tags/v3.5.3.tar.gz"],
)

http_archive(
    name = "spdlog",
    build_file = "//third_party:spdlog.BUILD",
    sha256 = "15a04e69c222eb6c01094b5c7ff8a249b36bb22788d72519646fb85feb267e67",
    strip_prefix = "spdlog-1.15.3",
    urls = ["https://github.com/gabime/spdlog/archive/refs/tags/v1.15.3.tar.gz"],
)

http_archive(
    name = "croaring",
    build_file = "//third_party:croaring.BUILD",
    sha256 = "a7d8c10c954a971b7e2996b498cb7600e5002637412f4198dcd600b415e1eb5c",
    strip_prefix = "CRoaring-5.2.2",
    urls = ["https://github.com/RoaringBitmap/CRoaring/archive/refs/tags/v5.2.2.tar.gz"],
)

http_archive(
    name = "lmdb",
    build_file = "//third_party:lmdb.BUILD",
    sha256 = "dd70a8c67807b3b8532b3e987b0a4e998962ecc28643e1af5ec77696b081c9b0",
    strip_prefix = "lmdb-LMDB_0.9.31/libraries/liblmdb",
    urls = ["https://github.com/LMDB/lmdb/archive/refs/tags/LMDB_0.9.31.tar.gz"],
)

# The xclang libclang package of the host; its version is pixi.toml's xclang.
libclang_repository = use_repo_rule("//third_party:libclang.bzl", "libclang_repository")

libclang_repository(
    name = "llvm",
    build_file = "//third_party:llvm.BUILD",
    version = "23.1.2.4",
)

# The C++ toolchain on every platform, from pixi's xclang.
xclang_toolchain = use_repo_rule("//toolchain:xclang.bzl", "xclang_toolchain")

xclang_toolchain(name = "xclang")

register_toolchains("@xclang//:toolchain")
