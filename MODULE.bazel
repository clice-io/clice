# The xclang libclang package. Spike: the directory cmake/llvm.cmake already
# downloaded (CLICE_LLVM_ROOT); the real setup would http_archive the release.
env_dir_repository = use_repo_rule("//third_party:local.bzl", "env_dir_repository")

env_dir_repository(
    name = "llvm",
    build_file = "//third_party:llvm.BUILD",
    env = "CLICE_LLVM_ROOT",
)

# Windows: xclang's clang targeting MinGW; rules_cc's MinGW toolchain is MSYS2
# gcc.
xclang_toolchain = use_repo_rule("//toolchain:xclang.bzl", "xclang_toolchain")

xclang_toolchain(name = "xclang_mingw")

register_toolchains("@xclang_mingw//:toolchain")
