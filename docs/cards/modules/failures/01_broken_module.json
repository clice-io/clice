{
  "id": "modules/failures/01_broken_module",
  "topic": "modules",
  "subtopic": "failures",
  "title": "Broken modules",
  "summary": "A module that fails to build reports its own errors, and the files importing it report the import",
  "prose": "",
  "status": "partial",
  "issues": [],
  "files": [
    {
      "path": "bad.cppm",
      "text": "export module Bad;\nimport Good;\n\nexport int bad() {\n    return UNDEFINED_SYMBOL + good();\n}\n",
      "markers": []
    },
    {
      "path": "good.cppm",
      "text": "export module Good;\n\nexport int good() {\n    return 1;\n}\n",
      "markers": []
    },
    {
      "path": "main.cpp",
      "text": "import Bad;\n\nint main() {\n    return bad();\n}\n",
      "markers": []
    }
  ],
  "tests": [
    {
      "name": "the module reports its errors",
      "blocks": [
        {
          "label": "bad.cppm",
          "value": {
            "errors": [
              {
                "at": {
                  "$place": "return ⟦UNDEFINED_SYMBOL⟧ + good();",
                  "path": "bad.cppm",
                  "range": {
                    "start": {
                      "line": 4,
                      "character": 11
                    },
                    "end": {
                      "line": 4,
                      "character": 27
                    }
                  }
                },
                "severity": "error",
                "message": "use of undeclared identifier 'UNDEFINED_SYMBOL'",
                "source": "clang",
                "code": "err_undeclared_var_use"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "the importer reports the import",
      "blocks": [
        {
          "label": "main.cpp",
          "value": {
            "wrong": "Bad exists but fails to build; the import should say so and point at its error, not report the module as not found",
            "errors": [
              {
                "at": {
                  "$place": "import ⟦Bad;⟧",
                  "path": "main.cpp",
                  "range": {
                    "start": {
                      "line": 0,
                      "character": 7
                    },
                    "end": {
                      "line": 0,
                      "character": 11
                    }
                  }
                },
                "severity": "error",
                "message": "module 'Bad' not found",
                "source": "clang",
                "code": "err_module_not_found"
              }
            ]
          }
        },
        {
          "label": "after an edit",
          "value": {
            "wrong": "Bad exists but fails to build; the import should say so and point at its error, not report the module as not found",
            "errors": [
              {
