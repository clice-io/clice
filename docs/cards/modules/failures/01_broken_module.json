                      "line": 0,
                      "character": 7
                    },
                    "end": {
                      "line": 0,
                      "character": 11
                    }
                  }
                },
                "severity": "error",
                "message": "module 'Bad' not found",
                "source": "clang",
                "code": "err_module_not_found"
              }
            ]
          }
        }
      ]
    }
  ]
