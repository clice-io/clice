{
  "id": "modules/units/09_header_units",
  "topic": "modules",
  "subtopic": "units",
  "title": "Header units",
  "summary": "Importing a header as a header unit, `import \"local.h\";` or `import <util.h>;`, is not supported yet",
  "prose": "",
  "status": "unsupported",
  "issues": [],
  "files": [
    {
      "path": "include/util.h",
      "text": "#pragma once\n\ninline int util() {\n    return 2;\n}\n",
      "markers": []
    },
    {
      "path": "local.h",
      "text": "#pragma once\n\ninline int local() {\n    return 1;\n}\n",
      "markers": []
    },
    {
      "path": "main.cpp",
      "text": "import \"local.h\";\nimport <util.h>;\n\nint main() {\n    return local() + util();\n}\n",
      "markers": []
    }
  ],
  "tests": [
    {
      "name": "test",
      "blocks": [
        {
          "label": "main.cpp",
          "value": {
            "wrong": "header units are not supported: both headers should import as header units, declaring local() and util()",
            "errors": [
              {
                "at": {
                  "$place": "import ⟦\"local.h\"⟧;",
                  "path": "main.cpp",
                  "range": {
                    "start": {
                      "line": 0,
                      "character": 7
                    },
                    "end": {
                      "line": 0,
                      "character": 16
                    }
                  }
                },
                "severity": "error",
                "message": "header file \"local.h\" (aka '${WS}/local.h') cannot be imported because it is not known to be a header unit",
                "source": "clang",
                "code": "err_header_import_not_header_unit"
              },
              {
                "at": {
                  "$place": "import ⟦<⟧util.h>;",
                  "path": "main.cpp",
                  "range": {
                    "start": {
                      "line": 1,
                      "character": 7
                    },
                    "end": {
                      "line": 1,
                      "character": 8
                    }
                  }
                },
                "severity": "error",
                "message": "header file <util.h> (aka '${WS}/include/util.h') cannot be imported because it is not known to be a header unit",
                "source": "clang",
                "code": "err_header_import_not_header_unit"
              },
              {
                "at": {
                  "$place": "return ⟦local⟧() + util();",
