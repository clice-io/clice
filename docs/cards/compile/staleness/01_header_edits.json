{
  "id": "compile/staleness/01_header_edits",
  "topic": "compile",
  "subtopic": "staleness",
  "title": "Changes outside the editor",
  "summary": "A header changed on disk reaches the files that include it at their next request, saved or not",
  "prose": "Checkouts, generators and other tools rewrite headers behind the editor's back. The next request about an including file compiles it against the new text, wherever the header sits in its includes, while a rewrite of the same bytes costs nothing.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "base.h",
      "text": "#pragma once\n\ninline int base() {\n    return 1;\n}\n",
      "markers": []
    },
    {
      "path": "late.h",
      "text": "#pragma once\n\ninline int late() {\n    return 1;\n}\n",
      "markers": []
    },
    {
      "path": "main.cpp",
      "text": "#include \"pre.h\"\n\nint main() {\n    return pre();\n}\n\n#include \"late.h\"\n\nint tail() {\n    return late();\n}\n",
      "markers": []
    },
    {
      "path": "other.cpp",
      "text": "#include \"pre.h\"\n\nint other() {\n    return pre();\n}\n",
      "markers": []
    },
    {
      "path": "pre.h",
      "text": "#pragma once\n\n#include \"base.h\"\n\nstruct Widget {\n    int alpha_member;\n};\n\ninline int pre() {\n    return base();\n}\n",
      "markers": []
    }
  ],
  "tests": [
