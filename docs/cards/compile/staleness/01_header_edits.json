      "name": "precompiled header edit",
      "blocks": [
        {
          "label": "renamed",
          "value": {
            "errors": [
              {
                "at": {
                  "$place": "return ⟦pre⟧();",
                  "path": "main.cpp",
                  "range": {
                    "start": {
                      "line": 3,
                      "character": 11
                    },
                    "end": {
                      "line": 3,
                      "character": 14
                    }
                  }
                },
                "severity": "error",
                "message": "use of undeclared identifier 'pre'",
                "source": "clang",
                "code": "err_undeclared_var_use"
              }
            ]
          }
        }
