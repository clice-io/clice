{
  "id": "compile/encoding/01_byte_order_mark",
  "topic": "compile",
  "subtopic": "encoding",
  "title": "Byte order marks",
  "summary": "Files saved as UTF-8 with a byte order mark work like any other",
  "prose": "Positions on the first line skip the mark, as the editor shows it, and data a file embeds keeps its bytes. Saving an open file with the mark or without it changes nothing the editor shows.",
  "status": "supported",
  "issues": [],
