      "path": "a.h",
      "text": "﻿int shared_fn();\n",
      "markers": []
    },
    {
      "path": "c.cpp",
      "text": "﻿int user3() {\n    return 3;\n}\n\n#include \"a.h\"\n",
      "markers": []
    },
    {
      "path": "data.bin",
      "text": "﻿AB",
      "markers": []
    },
    {
      "path": "embed.cpp",
      "text": "constexpr unsigned char data[] = {\n#embed \"data.bin\"\n};\n\nstatic_assert(sizeof(data) == 5);\n",
      "markers": []
    },
    {
      "path": "main.cpp",
      "text": "﻿#include \"types.h\"\n#include \"utils.h\"\n#include \"a.h\"\n\nint main() {\n    return get_x({1, 2}) + shared_fn();\n}\n",
      "markers": []
    },
    {
