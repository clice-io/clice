{
  "id": "compile/flags/01_forced_include",
  "topic": "compile",
  "subtopic": "flags",
  "title": "Forced includes",
  "summary": "Headers a command forces in with `-include` work like the ones a file includes itself",
  "prose": "Build systems force headers in for configuration macros and precompiled headers. Their macros hover and navigate, and editing them reaches every file they are forced into.",
  "status": "supported",
  "issues": [],
