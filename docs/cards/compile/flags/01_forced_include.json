    {
      "path": "header.h",
      "text": "inline int header() {\n    return FORCED;\n}\n",
      "markers": []
    },
    {
      "path": "main.cpp",
      "text": "#include \"header.h\"\n\nint main() {\n    return header();\n}\n",
      "markers": []
    },
    {
      "path": "other.cpp",
      "text": "int other() {\n    return FORCED;\n}\n",
      "markers": [
