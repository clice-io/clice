{
  "id": "compile/flags/07_precompiled_headers",
  "topic": "compile",
  "subtopic": "flags",
  "title": "Precompiled headers",
  "summary": "The units of a target with precompiled headers share one PCH, built by clice from the build's command",
  "prose": "CMake gives every unit of such a target the precompiled header it builds from `cmake_pch.hxx.cxx`. The file on disk may come from another compiler, so clice builds its own from the same command: the target's headers are parsed once for every file open and for the index, and editing one of them rebuilds the PCH and reaches every unit.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "build/CMakeFiles/app.dir/cmake_pch.hxx.cxx",
      "text": "/* generated by CMake */\n",
      "markers": []
    },
    {
      "path": "build/CMakeFiles/app.dir/cmake_pch.hxx",
      "text": "/* generated by CMake */\n\n#pragma clang system_header\n#ifdef __cplusplus\n#include \"${WS}/include/shapes.h\"\n#endif // __cplusplus\n",
      "markers": []
    },
    {
      "path": "build/CMakeFiles/tool.dir/cmake_pch.hxx.cxx",
      "text": "/* generated by CMake */\n",
      "markers": []
    },
    {
      "path": "build/CMakeFiles/tool.dir/cmake_pch.hxx",
      "text": "/* generated by CMake */\n\n#pragma GCC system_header\n#ifdef __cplusplus\n#include \"${WS}/include/shapes.h\"\n#endif // __cplusplus\n",
      "markers": []
    },
    {
      "path": "build/compile_commands.json",
      "text": "[\n  {\n    \"directory\": \"${WS}/build\",\n    \"command\": \"clang++ -I${WS}/include -std=c++20 -fpch-instantiate-templates -Xclang -emit-pch -Xclang -include -Xclang ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx -x c++-header -o CMakeFiles/app.dir/cmake_pch.hxx.pch -c ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx.cxx\",\n    \"file\": \"${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx.cxx\",\n    \"output\": \"CMakeFiles/app.dir/cmake_pch.hxx.pch\"\n  },\n  {\n    \"directory\": \"${WS}/build\",\n    \"command\": \"clang++ -I${WS}/include -std=c++20 -Winvalid-pch -Xclang -include-pch -Xclang ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx.pch -Xclang -include -Xclang ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx -o CMakeFiles/app.dir/src/main.cpp.o -c ${WS}/src/main.cpp\",\n    \"file\": \"${WS}/src/main.cpp\",\n    \"output\": \"CMakeFiles/app.dir/src/main.cpp.o\"\n  },\n  {\n    \"directory\": \"${WS}/build\",\n    \"command\": \"clang++ -I${WS}/include -std=c++20 -Winvalid-pch -Xclang -include-pch -Xclang ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx.pch -Xclang -include -Xclang ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx -o CMakeFiles/app.dir/src/area.cpp.o -c ${WS}/src/area.cpp\",\n    \"file\": \"${WS}/src/area.cpp\",\n    \"output\": \"CMakeFiles/app.dir/src/area.cpp.o\"\n  },\n  {\n    \"directory\": \"${WS}/build\",\n    \"command\": \"clang++ -I${WS}/include -std=c++20 -x c++-header -include ${WS}/build/CMakeFiles/tool.dir/cmake_pch.hxx -o CMakeFiles/tool.dir/cmake_pch.hxx.gch -c ${WS}/build/CMakeFiles/tool.dir/cmake_pch.hxx.cxx\",\n    \"file\": \"${WS}/build/CMakeFiles/tool.dir/cmake_pch.hxx.cxx\",\n    \"output\": \"CMakeFiles/tool.dir/cmake_pch.hxx.gch\"\n  },\n  {\n    \"directory\": \"${WS}/build\",\n    \"command\": \"clang++ -I${WS}/include -std=c++20 -Winvalid-pch -include ${WS}/build/CMakeFiles/tool.dir/cmake_pch.hxx -o CMakeFiles/tool.dir/src/tool.cpp.o -c ${WS}/src/tool.cpp\",\n    \"file\": \"${WS}/src/tool.cpp\",\n    \"output\": \"CMakeFiles/tool.dir/src/tool.cpp.o\"\n  }\n]\n",
      "markers": []
    },
