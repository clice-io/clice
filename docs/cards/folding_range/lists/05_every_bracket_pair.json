{
  "id": "folding_range/lists/05_every_bracket_pair",
  "topic": "folding_range",
  "subtopic": "lists",
  "title": "Every bracket pair",
  "summary": "Any parentheses, brackets or braces spanning lines fold, whatever writes them",
  "prose": "Conditions, casts, `static_assert`, parenthesized expressions, subscripts,\nattribute lists, function types and the arguments of a macro invocation fold\nlike a call's arguments do. An attribute list written `[[...]]` folds once.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "main.cpp",
      "text": "#define CHECK(condition) ((void)(condition))\n#define TABLE(...) int table[] = {__VA_ARGS__}\n\nint compute(int a, int b);\n\nusing Callback = void (*)(\n    int code,\n    const char* message);\n\n[[deprecated,\n  nodiscard]] int legacy();\n\nint run(int a, int b) {\n    if (a > 0 &&\n        b > 0 &&\n        a != b) {\n        a = 0;\n    }\n\n    for (int i = 0;\n         i < a;\n         i += 1) {\n        b += i;\n    }\n\n    int values[4] = {1, 2, 3, 4};\n    b += values[\n        a % 4\n    ];\n\n    auto value = (a +\n                  b +\n                  compute(a, b));\n\n    auto widened = static_cast<long>(\n        a * b);\n\n    static_assert(sizeof(int) >=\n                      2,\n                  \"int too small\");\n\n    CHECK(\n        a ==\n        b);\n\n    TABLE(\n        1,\n        2,\n        3);\n\n    return value + static_cast<int>(widened) + table[0];\n}\n",
      "markers": []
    }
  ],
