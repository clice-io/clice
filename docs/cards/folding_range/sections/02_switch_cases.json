  "topic": "folding_range",
  "subtopic": "sections",
  "title": "Switch cases",
  "summary": "Each case of a switch folds up to the next label, which stays visible",
  "prose": "Labels written one after another fold as one case. A case whose body is a\nblock opening on the label's line folds as that block.",
  "status": "supported",
  "issues": [],
