{
  "id": "folding_range/runs/02_includes",
  "topic": "folding_range",
  "subtopic": "runs",
  "title": "Include runs",
  "summary": "Consecutive include directives fold as one run below the first include",
  "prose": "A blank line, a comment line or another directive ends the run; includes\ninside a conditional branch fold within it, whether or not the branch is\ntaken.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "alpha.h",
      "text": "#pragma once\n",
      "markers": []
    },
    {
      "path": "beta.h",
      "text": "#pragma once\n",
      "markers": []
    },
    {
      "path": "delta.h",
      "text": "#pragma once\n",
      "markers": []
    },
    {
      "path": "gamma.h",
      "text": "#pragma once\n",
      "markers": []
    },
    {
      "path": "main.cpp",
      "text": "#include \"alpha.h\"\n#include \"beta.h\"\n#include \"gamma.h\"\n\n#include \"delta.h\"\n\n#include \"alpha.h\"\n// a comment line ends the run\n#include \"beta.h\"\n#define HEADER \"delta.h\"\n#include \"gamma.h\"\n#include HEADER\n\n#ifdef WINDOWS_BACKEND\n#include \"windows_api.h\"\n#include \"windows_io.h\"\n#else\n#include \"posix_api.h\"\n#include \"posix_io.h\"\n#endif\n",
      "markers": []
