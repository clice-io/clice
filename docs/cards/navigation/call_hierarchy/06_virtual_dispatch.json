      "path": "main.cpp",
      "text": "struct Base {\n    virtual void draw();\n};\n\nstruct Derived : Base {\n    void draw() override;\n};\n\nvoid call_base(Base& b) {\n    b.draw();\n}\n\nvoid call_derived(Derived& d) {\n    d.draw();\n}\n",
