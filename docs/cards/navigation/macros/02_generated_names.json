{
  "id": "navigation/macros/02_generated_names",
  "topic": "navigation",
  "subtopic": "macros",
  "title": "Macro-generated names",
  "summary": "A name a macro creates resolves to the invocation that creates it",
  "prose": "A use of a name assembled by token paste, or spelled in the macro's body,\nreaches the invocation, and the invocation's own name resolves to the\nmacro. A token inside the macro's body has no meaning until an expansion\ngives it one, so navigation on it answers nothing.",
  "status": "supported",
