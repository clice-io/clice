{
  "id": "navigation/macros/01_macro_arguments",
  "topic": "navigation",
  "subtopic": "macros",
  "title": "Names in macro arguments",
  "summary": "A name spelled in a macro argument navigates like a name written outside a macro",
  "prose": "Definition and declaration alternate at its spelling, and a later use\nreaches the function the macro declares. The macro's own name, at its\ndefinition or an invocation, resolves to the macro.",
  "status": "supported",
