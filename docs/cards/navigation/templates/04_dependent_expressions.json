      "path": "main.cpp",
      "text": "template <typename T>\nstruct Vec {\n    T& operator[](int index);\n    const T& operator[](int index) const;\n    T& front();\n    const T& front() const;\n    void push(const T& value);\n    void take(int count);\n    void take(long count) const;\n    void pick();\n    template <typename U>\n    void pick() const;\n};\n\ntemplate <typename T>\nvoid drain(Vec<Vec<T>> rows, const Vec<Vec<T>>& fixed, T value) {\n    rows[0].push(value);\n    rows.front().push(value);\n    fixed.front();\n    rows.take(1);\n    rows.template pick<int>();\n    auto& row = rows[0];\n    row.push(value);\n    auto copy(rows[0]);\n    copy.push(value);\n}\n",
