      "path": "main.cpp",
      "text": "#include \"geometry.h\"\n\nint scale(long factor) {\n    return static_cast<int>(factor * 2);\n}\n\nint scale(double factor) {\n    return static_cast<int>(factor * 2);\n}\n\nstatic int checksum(const char* data, int size) {\n    return data[0] + size;\n}\n\ntemplate <typename T>\nT area(T side) {\n    return side * side;\n}\n\nstatic int measure(int size);\n\nstatic int measure(long size) {\n    return static_cast<int>(size);\n}\n\nstatic int tally(int count);\n\nnamespace {\nint tally(long count) {\n    return static_cast<int>(count);\n}\n}  // namespace\n\nint use() {\n    Mutex mutex;\n    return checksum(\"x\", 1);\n}\n",
