      "path": "main.cpp",
      "text": "template <typename T>\nstruct Node {\n    T value;\n    Node* advance();\n};\n\ntemplate <typename T>\nvoid walk(Node<T>& node) {\n    auto next = node.advance();\n    auto value = node.value;\n}\n\ntemplate <typename T>\nvoid visit(Node<T>& node) {\n    auto value = node.value;\n}\n\nstruct Widget {};\n\nstruct Gadget {};\n\nvoid drive(Node<Widget>& widget, Node<Gadget>& gadget) {\n    walk(widget);\n    visit(widget);\n    visit(gadget);\n}\n\ntemplate <typename T>\nstruct Holder {\n    void reset() {\n        auto copy = T();\n    }\n};\n\ntemplate struct Holder<Gadget>;\n",
