  "subtopic": "implementation",
  "title": "Template duck-type navigation",
  "summary": "Go to implementation on a dependent call reaches the method it resolves to in each of the template's instantiations",
  "prose": "This applies to function templates and generic lambdas alike, and to a\nconversion operator called by name.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "main.cpp",
      "text": "template <typename T>\nvoid process(T& obj) {\n    obj.foo();\n}\n\nstruct A {\n    void foo() {}\n};\n\nvoid run(A a) {\n    process(a);\n}\n\nstruct B {\n    void bar() {}\n};\n\nvoid generic(B b) {\n    auto call = [](auto& x) { x.bar(); };\n    call(b);\n}\n\ntemplate <typename T>\nvoid twice(T& obj) {\n    obj.foo();\n}\n\nstruct C {\n    void foo() {}\n};\n\nvoid both(A a, C c) {\n    twice(a);\n    twice(c);\n}\n\ntemplate <typename T>\nint convert(T& value) {\n    return value.operator int();\n}\n\nstruct D {\n    operator int() {\n        return 4;\n    }\n};\n\nint use_convert(D d) {\n    return convert(d);\n}\n",
