{
  "id": "inlay_hints/parameter_hints/07_definition_names",
  "topic": "inlay_hints",
  "subtopic": "parameter_hints",
  "title": "Names from other declarations",
  "summary": "Unnamed declaration parameters take the names another declaration or the definition gives them; a reserved name drops its leading underscores",
  "prose": "When both the declaration and the definition name a parameter, the declaration wins. A reserved name like `__count` shows as `count`; `_value`, an ordinary name, stays as written.",
  "status": "supported",
