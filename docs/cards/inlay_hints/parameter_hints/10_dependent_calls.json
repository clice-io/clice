  "subtopic": "parameter_hints",
  "title": "Dependent calls",
  "summary": "Parameter names appear even when the callee is only known inside a template",
  "prose": "Candidates are matched by argument count; only a unique surviving candidate names the parameters, so a call that could still hit several overloads stays bare rather than guessing.",
  "status": "supported",
