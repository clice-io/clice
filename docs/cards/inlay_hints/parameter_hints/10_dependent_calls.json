      "path": "main.cpp",
      "text": "template <typename T>\nvoid apply(T scale);\n\ntemplate <typename T>\nstruct Holder {\n    void member(T item);\n    static void static_member(T slot);\n};\n\nvoid overload(int value);\nvoid overload(double value);\n\ntemplate <typename T>\nstruct Runner {\n    void run(Holder<T> holder, T value) {\n        apply(value);\n        holder.member(value);\n        Holder<T>::static_member(value);\n        overload(T{});\n    }\n};\n",
