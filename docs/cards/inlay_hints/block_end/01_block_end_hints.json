{
  "id": "inlay_hints/block_end/01_block_end_hints",
  "topic": "inlay_hints",
  "subtopic": "block_end",
  "title": "Names after closing braces",
  "summary": "After the closing brace of a block spanning lines, a hint names what the brace closes",
  "prose": "Functions, types, namespaces and control flow get one; `if` and `while` show their condition when it is short, an `else if` chain shows as plain `// if`, and a label longer than 60 characters is dropped. A block on one line gets none.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "main.cpp",
      "text": "namespace detail {\n\nstruct Widget {\n    int width;\n    int height;\n};\n\nint area(const Widget& widget) {\n    int total = 0;\n    while (total < widget.width) {\n        total += widget.height;\n    }\n    if (total > 10) {\n        total = 10;\n    } else if (total < 0) {\n        total = 0;\n    }\n    if (widget.width > widget.height && widget.height > 0 && total != widget.width) {\n        total += 1;\n    }\n    return total;\n}\n\nint tiny() { return 0; }\n\nint a_function_whose_name_alone_is_long_enough_to_pass_sixty_chars() {\n    return 0;\n}\n\n}\n\n",
