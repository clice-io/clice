      "text": "#include <map>\n#include <string>\n#include <tuple>\n\nstruct Point {\n    int x;\n    int y;\n};\n\nusing Count = unsigned long;\nusing Size = unsigned long;\nusing Table = std::map<std::string, Point>;\n\nvoid walk(std::map<std::string, Point>& points,\n          std::tuple<std::string, Point>& entry,\n          std::map<Count, Size>& sizes) {\n    for (auto& [name, point] : points) {\n    }\n    auto& [label, origin] = entry;\n    for (auto& [count, size] : sizes) {\n    }\n    std::string text;\n    auto copy = text;\n}\n\nvoid look(Table& table,\n          std::tuple<std::string*, Point>& found,\n          std::tuple<Count, unsigned long>& counted) {\n    for (auto& [key, value] : table) {\n    }\n    auto& [where, place] = found;\n    auto& [first, second] = counted;\n}\n",
