{
  "id": "selection_range/syntax_ranges/02_statements",
  "topic": "selection_range",
  "subtopic": "syntax_ranges",
  "title": "Statements and declarations",
  "summary": "A statement or declaration is selected with the semicolon that ends it, after the part before it",
  "prose": "A local variable steps from its declarator to the declaration statement.\nA member, a global or a function declaration gains its semicolon the\nsame way; a template's declaration gains it before its `template` head\njoins.",
  "status": "supported",
