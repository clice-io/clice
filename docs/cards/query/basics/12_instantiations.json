          "value": {
            "stdout": "{\n  \"result\": {\n    \"name\": \"open\",\n    \"kind\": \"Method\",\n    \"symbol\": \"#66ed736b7a4ce853\",\n    \"references\": [\n      {\n        \"file\": \"${WS}/main.cpp\",\n        \"line\": 9,\n        \"context\": \"    item.open();\",\n        \"function\": \"twice\",\n        \"via\": \"instantiation\"\n      },\n      {\n        \"file\": \"${WS}/main.cpp\",\n        \"line\": 10,\n        \"context\": \"    box.open();\",\n        \"function\": \"twice\"\n      },\n      {\n        \"file\": \"${WS}/measure.h\",\n        \"line\": 5,\n        \"context\": \"    item.open();\",\n        \"function\": \"measure\",\n        \"via\": \"instantiation\"\n      }\n    ],\n    \"total\": 3\n  },\n  \"stale\": []\n}",
