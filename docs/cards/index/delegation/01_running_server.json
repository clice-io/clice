{
  "id": "index/delegation/01_running_server",
  "topic": "index",
  "subtopic": "delegation",
  "title": "Through a running server",
  "summary": "While an editor's clice server runs, `clice index` and `--fresh` ask it to index instead of indexing alongside it",
  "prose": "",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "a.h",
      "text": "#pragma once\nint add(int a, int b);\nstruct Animal { virtual ~Animal() = default; };\n",
      "markers": []
    },
    {
      "path": "main.cpp",
      "text": "#include \"a.h\"\nint add(int a, int b) { return a + b; }\nstruct Dog : Animal {};\nint compute() { return add(1, 2); }\nint main() { return compute(); }\n",
      "markers": []
    }
  ],
  "tests": [
    {
      "name": "asks the running server to index",
      "blocks": [
        {
          "label": "$ clice index --jobs 2",
          "value": {
            "stdout": "Indexed through the running clice server (pid #).",
            "exit": 0
          }
        },
        {
          "label": "$ clice index --json",
          "value": {
            "stdout": "{\n  \"failed\": []\n}",
            "exit": 0
          }
        },
        {
          "label": "$ clice query symbol-search extra --fresh",
          "value": {
            "stdout": "{\n  \"result\": {\n    \"symbols\": [\n      {\n        \"name\": \"extra\",\n        \"kind\": \"Function\",\n        \"file\": \"${WS}/main.cpp\",\n        \"line\": 5,\n        \"container\": null,\n        \"symbol\": \"#c9be3d07e9d6b64f\"\n      }\n    ]\n  },\n  \"stale\": []\n}",
            "exit": 0
          }
        },
        {
          "label": "$ clice query symbol-search extra",
          "value": {
            "stdout": "{\n  \"result\": {\n    \"symbols\": [\n      {\n        \"name\": \"extra\",\n        \"kind\": \"Function\",\n        \"file\": \"${WS}/main.cpp\",\n        \"line\": 5,\n        \"container\": null,\n        \"symbol\": \"#c9be3d07e9d6b64f\"\n      }\n    ]\n  },\n  \"stale\": []\n}",
            "exit": 0
          }
        }
      ]
    },
    {
      "name": "refuses a writer it cannot ask",
      "blocks": [
        {
          "label": "$ clice index",
          "value": {
            "stderr": "error: another clice process (pid #) holds the index writer lock at ${WS}/.clice; retry when it is done",
            "exit": 1
          }
        },
        {
          "label": "$ clice query symbol-search compute --fresh",
          "value": {
            "stdout": "{\n  \"error\": \"another clice process (pid #) holds the index writer lock at ${WS}/.clice; retry when it is done\",\n  \"stale\": []\n}",
            "exit": 1
          }
        },
        {
          "label": "$ clice query symbol-search compute",
          "value": {
            "stdout": "{\n  \"result\": {\n    \"symbols\": [\n      {\n        \"name\": \"compute\",\n        \"kind\": \"Function\",\n        \"file\": \"${WS}/main.cpp\",\n        \"line\": 4,\n        \"container\": null,\n        \"symbol\": \"#81df9416985c4402\"\n      }\n    ]\n  },\n  \"stale\": []\n}",
            "exit": 0
          }
        }
      ]
    }
  ]
}
