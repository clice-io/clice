{
  "id": "semantic_tokens/preprocessor/03_inactive_branches",
  "topic": "semantic_tokens",
  "subtopic": "preprocessor",
  "title": "Untaken branches",
  "summary": "Tokens in untaken branches keep their lexical kinds and carry the `inactive` modifier",
  "prose": "Text with no kind of its own becomes a `plain` token, so even a lone `}`\nline dims.",
  "status": "supported",
