{
  "id": "semantic_tokens/modifiers/13_templates",
  "topic": "semantic_tokens",
  "subtopic": "modifiers",
  "title": "Templates",
  "summary": "A class, alias, variable or function template is `template` wherever it is named",
  "prose": "So is a specialization of it, and the `<` and `>` around template arguments\nare `bracket` tokens, told apart from comparisons.",
  "status": "supported",
  "issues": [],
