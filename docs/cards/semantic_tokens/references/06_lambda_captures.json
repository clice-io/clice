      "path": "main.cpp",
      "text": "struct S {\n    int field;\n\n    int compute() {\n        int local = 1;\n        auto by_copy = [local, this] {\n            return local + this->field;\n        };\n        auto by_reference = [&local] {\n            return local;\n        };\n        return by_copy() + by_reference();\n    }\n};\n",
