  "topic": "document_highlight",
  "subtopic": "access_kinds",
  "title": "Member access",
  "summary": "Writing through `object.member` writes the member and reads the object",
  "prose": "A designated initializer or a constructor's member initializer names the field without writing it. Fields of an anonymous union highlight like any other field.",
  "status": "supported",
