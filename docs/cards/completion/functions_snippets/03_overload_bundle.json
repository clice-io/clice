{
  "id": "completion/functions_snippets/03_overload_bundle",
  "topic": "completion",
  "subtopic": "functions_snippets",
  "title": "Overload bundling",
  "summary": "An overload set collapses into one entry with an overload count",
  "prose": "With bundling off, every overload is its own entry with its own signature.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "main.cpp",
      "text": "int foooo(int x);\nint foooo(int x, int y);\ndouble foooo(double d);\n\nint x = fooo;\n",
      "markers": [
        {
          "name": "pos",
          "begin": 80,
          "end": 80,
          "range": false
        }
      ]
    }
  ],
  "tests": [
    {
      "name": "default",
      "blocks": [
        {
          "label": "pos",
          "marker": "pos",
          "value": {
            "completion": {
              "items": [
                {
                  "label": "foooo(…) +3 overloads",
                  "kind": "Function"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "configured",
      "config": {
        "code_completion": {
          "bundle_overloads": false
        }
      },
      "blocks": [
        {
          "label": "pos",
          "marker": "pos",
          "value": {
            "completion": {
              "items": [
                {
                  "label": "foooo(double d)",
                  "kind": "Function",
                  "detail": "double"
                },
                {
                  "label": "foooo(int x)",
                  "kind": "Function",
                  "detail": "int"
                },
                {
                  "label": "foooo(int x, int y)",
                  "kind": "Function",
                  "detail": "int"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
