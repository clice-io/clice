{
  "id": "workspace_symbol/scopes/01_qualified_names",
  "topic": "workspace_symbol",
  "subtopic": "scopes",
  "title": "Qualified name search",
  "summary": "A qualified query names the containers the symbol must lie in",
  "prose": "`net::Socket` finds `deep::net::Socket`: the qualifiers must appear in the\nsymbol's container chain in that order, with other containers allowed\naround them, while a leading `::` demands exactly that chain. Replies to\na qualified query spell the qualified name, so editors that filter\nresults against the query text keep them.",
  "status": "supported",
  "issues": [
    "clangd#550"
  ],
