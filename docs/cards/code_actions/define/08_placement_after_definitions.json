{
  "id": "code_actions/define/08_placement_after_definitions",
  "topic": "code_actions",
  "subtopic": "define",
  "title": "Placement after existing definitions",
  "summary": "When the class already has out-of-line definitions in the file, the new one goes after the last of them",
  "prose": "The qualifier follows the scope of that definition, not the class's.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "main.cpp",
      "text": "namespace ns {\nstruct S {\n    void a();\n    void b();\n};\n}\n\nvoid ns::S::a() {\n}\n",
      "markers": [
        {
          "name": "b",
          "begin": 49,
          "end": 49,
          "range": false
        }
      ]
    }
  ],
  "tests": [
    {
      "name": "answers",
      "blocks": [
        {
          "label": "b",
          "marker": "b",
          "value": {
            "code_actions": [
              {
                "kind": "refactor.rewrite.define.inline",
                "title": "Define 'b' inline",
                "compiles": true,
                "edits": {
                  "main.cpp": " struct S {\n     void a();\n-    void b();\n+    void b() {}\n };\n }"
                }
              },
              {
                "kind": "refactor.rewrite.define.outOfLine",
                "title": "Define 'ns::S::b' out of line",
                "compiles": true,
                "edits": {
                  "main.cpp": " void ns::S::a() {\n }\n+\n+void ns::S::b() {\n+}"
                }
              }
            ]
          }
        }
      ]
    }
  ]
