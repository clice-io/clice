{
  "id": "project/configurations/07_linked_build",
  "topic": "project",
  "subtopic": "configurations",
  "title": "One index per linked build",
  "summary": "A rule resolving symlinks keeps an index for each build its link points to, and follows the link when it moves",
  "prose": "The build system points `out/current` at the build it chose. Pointed at `out/debug`, which the `debug` configuration names too, the server switches to that configuration's index; pointed back at `out/release`, the release index serves again and nothing is indexed anew.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "clice.toml",
      "text": "default_configuration = \"active\"\n\n# The build system points out/current at the build it chose.\n[[rules]]\nconfiguration = \"active\"\ncompile_commands = [\"out/current\"]\nresolve_symlinks = true\n\n[[rules]]\nconfiguration = \"debug\"\ncompile_commands = [\"out/debug\"]\n",
      "markers": []
    },
    {
      "path": "main.cpp",
      "text": "#ifdef RELEASE\nint release_only = 2;\n#else\nint debug_only = 1;\n#endif\n\nint main() {\n    return 0;\n}\n",
      "markers": []
    },
    {
      "path": "out/debug/compile_commands.json",
      "text": "[\n  {\n    \"directory\": \"${WS}\",\n    \"file\": \"${WS}/main.cpp\",\n    \"arguments\": [\"clang++\", \"-std=c++20\", \"-DDEBUG\", \"-fsyntax-only\", \"${WS}/main.cpp\"]\n  }\n]\n",
      "markers": []
    },
    {
      "path": "out/release/compile_commands.json",
      "text": "[\n  {\n    \"directory\": \"${WS}\",\n    \"file\": \"${WS}/main.cpp\",\n    \"arguments\": [\"clang++\", \"-std=c++20\", \"-DRELEASE\", \"-fsyntax-only\", \"${WS}/main.cpp\"]\n  }\n]\n",
      "markers": []
    }
  ],
