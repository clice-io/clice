      "text": "template<typename T>\nstruct Less;\n\ntemplate<\n    typename Key,\n    typename Value,\n    typename Compare = Less<Key>\n>\nclass SortedMap {\n    template<\n        typename Other,\n        typename = void\n    >\n    void merge(const Other&);\n};\n\ntemplate<\n    typename Key,\n    typename Value,\n    typename Compare\n>\ntemplate<\n    typename Other,\n    typename\n>\nvoid SortedMap<Key, Value, Compare>::merge(const Other&) {}\n\ntemplate<\n    typename Value,\n    typename Compare\n>\nclass SortedMap<int, Value, Compare> {};\n\ntemplate<template<\n    typename,\n    typename\n> class Container>\nstruct Adapter {};\n\ntemplate<\n    typename T\n>\nconstexpr bool always = true;\n\ntemplate<\n    typename T\n>\nconstexpr bool always<T*> = false;\n\ntemplate<typename T,\n         typename U>\nusing First = T;\n\ntemplate<typename T>\nstruct Outer {\n    struct Inner;\n};\n\ntemplate<\n    typename T\n>\nstruct Outer<T>::Inner {};\n\nauto generic = []<\n    typename T,\n    typename U\n>(T left, U right) { return left + right; };\n",
