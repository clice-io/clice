{
  "id": "scan/includes/01_resolution",
  "topic": "scan",
  "subtopic": "includes",
  "title": "Resolve includes",
  "summary": "Each file lists the headers its includes resolve to, and the includes no search finds",
  "prose": "The scan resolves every `#include` the way the compiler searches for it: a quoted name from the includer's directory first, then the search path the command gives. It follows the headers it finds, and reports the includes it could not resolve by name.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "detail/impl.h",
      "text": "#pragma once\n\ninline int impl() {\n    return 0;\n}\n",
      "markers": []
    },
    {
      "path": "include/config.h",
      "text": "#pragma once\n",
      "markers": []
    },
    {
      "path": "main.cpp",
      "text": "#include \"util.h\"\n#include <config.h>\n#include \"missing.h\"\n\nint main() {\n    return value();\n}\n",
      "markers": []
    },
    {
      "path": "util.h",
      "text": "#pragma once\n\n#include \"detail/impl.h\"\n\ninline int value() {\n    return impl();\n}\n",
      "markers": []
    }
  ],
  "tests": [
    {
      "name": "test",
      "blocks": [
        {
          "label": "$ clice scan",
          "value": {
            "stdout": "Scanned 4 files (1 source, 3 headers) in #ms: 3 of 4 includes resolved.\n  ${WS}/main.cpp: \"missing.h\" not found",
            "exit": 0
          }
        },
        {
          "label": "$ clice scan --json",
          "value": {
            "stdout": "{\n  \"files\": [\n    {\n      \"path\": \"${WS}/detail/impl.h\",\n      \"source\": false,\n      \"modules\": [],\n      \"includes\": [],\n      \"unresolved\": []\n    },\n    {\n      \"path\": \"${WS}/include/config.h\",\n      \"source\": false,\n      \"modules\": [],\n      \"includes\": [],\n      \"unresolved\": []\n    },\n    {\n      \"path\": \"${WS}/main.cpp\",\n      \"source\": true,\n      \"modules\": [],\n      \"includes\": [\n        \"${WS}/util.h\",\n        \"${WS}/include/config.h\"\n      ],\n      \"unresolved\": [\n        \"\\\"missing.h\\\"\"\n      ]\n    },\n    {\n      \"path\": \"${WS}/util.h\",\n      \"source\": false,\n      \"modules\": [],\n      \"includes\": [\n        \"${WS}/detail/impl.h\"\n      ],\n      \"unresolved\": []\n    }\n  ]\n}",
            "exit": 0
          }
        }
      ]
    }
  ]
}
