      "text": "struct Meters {\n    double value;\n};\n\n#define SCALE 3\n\n#include \"ruler.h\"\n\nint main() {\n    return ruler_length().value > unit_length.value ? 0 : 1;\n}\n",
      "markers": []
    },
    {
