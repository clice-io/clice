{
  "id": "contexts/fragments/01_class_body",
  "topic": "contexts",
  "subtopic": "fragments",
  "title": "Class body fragments",
  "summary": "A file included inside a class body compiles as part of that class",
  "prose": "`body.inc` holds members that `rec.cpp` includes between the braces of `Record`. Opened on its own, it compiles inside the class, so it has no errors, lists its members, and hover and go-to-definition work on them.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "base.h",
      "text": "#pragma once\nstruct Base {};\n",
      "markers": []
    },
    {
      "path": "body.inc",
      "text": "int field_a;\nint field_b;\nint sum() const { return field_a + field_b; }\n",
      "markers": []
    },
    {
      "path": "rec.cpp",
      "text": "#include \"base.h\"\n\nstruct Record : Base {\n#include \"body.inc\"\n};\n\nint main() {\n    Record r;\n    return r.sum();\n}\n",
      "markers": []
    }
  ],
