{
  "id": "hover/symbols/18_objective_c",
  "topic": "hover",
  "subtopic": "symbols",
  "title": "Objective-C symbols",
  "summary": "Hovering an Objective-C class, protocol, method, property or instance variable shows its declaration and where it belongs",
  "prose": "A member names the class or the category declaring it, `Shape(Extras)`, and\nan `@implementation` shows the `@interface` it implements. Any piece of a\nselector shows its method.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "main.m",
      "text": "#import \"shape.h\"\n\n@interface Shape ()\n@property(nonatomic, copy) NSString *name;\n@end\n\n@implementation Shape\n@synthesize x = _x;\n\nstatic int shapes;\n\n+ (int)count {\n    return shapes;\n}\n\n+ (void)setCount:(int)count {\n    shapes = count;\n}\n\n- (int)area {\n    return _x * _x;\n}\n\n- (void)setX:(int)x y:(int)y {\n    _x = x + y;\n    _generation += 1;\n    _name = @\"moved\";\n}\n\n+ (instancetype)shapeWithX:(int)x {\n    Shape *shape = [[self alloc] init];\n    [shape setX:x y:0];\n    return shape;\n}\n\n- (void)draw {\n}\n@end\n\n@implementation Shape (Extras)\n- (void)wobble {\n    [self setX:self.x + 1 y:0];\n}\n@end\n\n@interface Circle : Shape\n@end\n\n@implementation Circle\n- (void)draw {\n    [super draw];\n}\n@end\n\nvoid render(id thing, id<Drawable> drawable, Shape *shape) {\n    [thing draw];\n    [drawable draw];\n    [shape draw];\n    Shape.count = 2;\n    SEL selector = @selector(setX:y:);\n    void (^block)(void) = ^{\n      [shape wobble];\n    };\n    block();\n    @try {\n        [Shape shapeWithX:1];\n    } @catch (Shape *error) {\n        [error draw];\n    } @finally {\n    }\n    (void)selector;\n}\n",
