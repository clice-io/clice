      "text": "namespace placeholder_types {\nstruct Result {};\nstruct Dimensions {\n    long rows;\n    long columns;\n};\ntemplate <typename T> struct Holder {};\n\nvoid locals() {\n    long source = 0;\n    auto first = 4L;\n    const auto second = 5L;\n    auto& third = source;\n    auto* fourth = &source;\n    auto fifth = &source;\n    auto sixth = [](long value) { return value; };\n    auto seventh = Holder<long>{};\n    auto [rows, columns] = Dimensions{};\n}\n\nauto explicit_result() -> long {\n    return 6;\n}\n\nauto inferred_result() {\n    return Result{};\n}\n\ntemplate <typename T> void pending() {\n    auto value = T{};\n    auto sum = value + 1;\n}\n}\n",
