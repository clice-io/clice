{
  "id": "hover/templates/10_library_specialization_members",
  "topic": "hover",
  "subtopic": "templates",
  "title": "Members through a dependent specialization",
  "summary": "A member of a class template reached through a dependent specialization of it reads the arguments the code names it with",
  "prose": "Over `lib::vector<Point<T>>`, `push_back` belongs to `lib::vector<Point<T>>` and its `value_type` is `Point<T>`, not the template's own `_Tp`; the `second` of the `pair<const int, T>` a `map<int, T>` finds is a `T`.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "lib.h",
      "text": "#pragma once\n\nnamespace lib {\ntemplate <class _Tp>\nstruct vector {\n    using value_type = _Tp;\n    void push_back(const value_type& __x);\n    _Tp& front();\n    vector& append(const vector& __other);\n};\n\ntemplate <class _T1, class _T2>\nstruct pair {\n    _T1 first;\n    _T2 second;\n};\n\ntemplate <class _Key, class _Val>\nstruct map {\n    pair<const _Key, _Val>* find(const _Key& key);\n};\n}  // namespace lib\n",
      "markers": []
    },
    {
      "path": "main.cpp",
      "text": "#include \"lib.h\"\n\ntemplate <class T>\nstruct Point {\n    T x;\n};\n\ntemplate <class T>\nvoid f(lib::vector<Point<T>>& pts, lib::map<int, T>& m) {\n    pts.push_back(Point<T>{});\n    pts.append(pts);\n    auto value = m.find(1)->second;\n    typename lib::vector<Point<T>>::value_type copy = pts.front();\n}\n",
