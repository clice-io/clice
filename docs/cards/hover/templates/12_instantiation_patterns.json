{
  "id": "hover/templates/12_instantiation_patterns",
  "topic": "hover",
  "subtopic": "templates",
  "title": "Instantiation patterns",
  "summary": "A use of an instantiation shows the template it was instantiated from, with the arguments it binds",
  "prose": "A partial specialization shows itself, and a member of a class template its class's arguments first. Arguments a default gives and empty packs are left out; an explicit specialization shows as it is written.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "main.cpp",
      "text": "namespace instantiation_patterns {\n\ntemplate <typename T, typename Alloc = void> struct Store {\n    T* items;\n};\n\ntemplate <typename T> struct Store<T*, void> {\n    T** slots;\n};\n\ntemplate <> struct Store<bool> {\n    unsigned bits;\n};\n\ntemplate <typename T> struct Queue {\n    void push(const T& item);\n\n    template <typename U> U convert() const;\n\n    template <int Capacity> struct Ring {\n        T items[Capacity];\n    };\n};\n\ntemplate <> template <int Capacity> struct Queue<char>::Ring {\n    char spare[Capacity];\n};\n\ntemplate <typename T> struct List {\n    struct iterator {\n        T& operator*();\n    };\n};\n\ntemplate <typename T, typename... Rest> void log(T first, Rest... rest);\n\nvoid show(auto value);\n\nvoid use() {\n    Store<int> numbers;\n    Store<char*> names;\n    Store<bool> flags;\n\n    Queue<long> queue;\n    queue.push(1);\n    queue.convert<double>();\n    Queue<long>::Ring<8> ring;\n    Queue<char>::Ring<2> spare;\n\n    List<int>::iterator it;\n    it.operator*();\n\n    log(1);\n    show(1);\n}\n\n}\n",
