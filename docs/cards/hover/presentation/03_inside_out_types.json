{
  "id": "hover/presentation/03_inside_out_types",
  "topic": "hover",
  "subtopic": "presentation",
  "title": "Types read left to right",
  "summary": "A type C++ writes inside out reads left to right: `*`, `&` and `[N]` follow what they apply to, a function reads `(params) -> R`, a member pointer `C::-> T`",
  "prose": "A function inside a function, or a member pointer inside a member pointer, is named by a Greek letter, spelled on the line below.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "main.cpp",
      "text": "namespace inside_out {\n\nstruct Widget {\n    double scale(double factor) const;\n    void reset() & noexcept;\n    int id;\n    void (*hooks[4])(int);\n};\n\nstruct Holder {\n    int Widget::* member;\n};\n\nint storage[16];\n\nvoid (*on_exit)(int);\nint (&row)[16] = storage;\nchar (*line)[80];\nvoid (*handlers[8])(int, const char*);\nint (*print)(const char*, ...);\nint (*any)(...);\nconst auto& view = storage;\ndouble (Widget::*scaler)(double) const = &Widget::scale;\nvoid (Widget::*resetter)() & noexcept = &Widget::reset;\nint Widget::*field = &Widget::id;\nvoid (*(Widget::*table)[4])(int) = &Widget::hooks;\nint Widget::* const fixed = &Widget::id;\nint Widget::* Holder::*chain = &Holder::member;\n\nvoid (*signal(int, void (*)(int)))(int);\n\nusing Table = void (*[8])(int);\nTable dispatch;\n\n}\n",
