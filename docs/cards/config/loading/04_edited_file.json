{
  "id": "config/loading/04_edited_file",
  "topic": "config",
  "subtopic": "loading",
  "title": "Changes restart the server",
  "summary": "clice reads `clice.toml` when the server starts. Saving it makes the server ask the editor to restart it, and the edit applies in the new server",
  "prose": "The rule gains the macro while the server runs; once the editor restarted the server, `main.cpp` compiles with it.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "clice.toml",
      "text": "[[rules]]\npatterns = [\"**/*.cpp\"]\nappend = [\"-DUNRELATED\"]\n",
      "markers": []
    },
    {
      "path": "main.cpp",
      "text": "int value() {\n    return FROM_TOML;\n}\n",
      "markers": []
    }
  ],
  "tests": [
    {
      "name": "test",
      "blocks": [
        {
          "label": "before",
          "value": {
            "diagnostics": [
              {
                "at": {
                  "$place": "return ⟦FROM_TOML⟧;",
                  "path": "main.cpp",
                  "range": {
                    "start": {
                      "line": 1,
                      "character": 11
                    },
                    "end": {
                      "line": 1,
                      "character": 20
                    }
                  }
                },
                "severity": "error",
                "message": "use of undeclared identifier 'FROM_TOML'",
                "source": "clang",
                "code": "err_undeclared_var_use"
              }
            ]
          }
        },
        {
          "label": "asked",
          "value": {
            "value": "${WS}/clice.toml changed"
          }
        },
        {
          "label": "restarted",
          "value": {
            "diagnostics": []
          }
        }
      ]
    }
  ]
}
