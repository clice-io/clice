{
  "id": "analyze/dependencies/01_directory_modules",
  "topic": "analyze",
  "subtopic": "dependencies",
  "title": "Directory modules",
  "summary": "Each directory is a module, and a file naming another module's entity makes the dependency",
  "prose": "A header naming another module's entity is an interface edge, which would\nbecome an import of the module's interface; a source alone makes an\nimplementation edge. Outside a git repository the churn annotation is left\nout, with a warning.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "app/main.cpp",
      "text": "#include \"util/clock.h\"\n\nint main() {\n    Clock clock{};\n    return clock.size();\n}\n",
      "markers": []
    },
    {
      "path": "core/str.cpp",
      "text": "#include \"core/str.h\"\n\nint length(const Str& s) {\n    return s.n;\n}\n",
      "markers": []
    },
    {
      "path": "core/str.h",
      "text": "#pragma once\n\nstruct Str {\n    int n;\n};\n\nint length(const Str& s);\n",
      "markers": []
    },
    {
      "path": "util/clock.h",
      "text": "#pragma once\n#include \"core/str.h\"\n\nstruct Clock {\n    Str name;\n\n    int size() const {\n        return length(name);\n    }\n};\n",
      "markers": []
    }
  ],
