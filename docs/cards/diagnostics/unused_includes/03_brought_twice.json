{
  "id": "diagnostics/unused_includes/03_brought_twice",
  "topic": "diagnostics",
  "subtopic": "unused_includes",
  "title": "Brought by another include",
  "summary": "An include whose headers another include brings too is reported",
  "prose": "When two includes bring the same headers and the file uses nothing else of the second, the second is reported: the reported ones can all go at once.",
  "status": "supported",
  "issues": [],
  "files": [
    {
      "path": "a.h",
      "text": "#pragma once\n#include \"common.h\"\nint first();\n",
      "markers": []
    },
    {
      "path": "b.h",
      "text": "#pragma once\n#include \"common.h\"\nint second();\n",
      "markers": []
    },
    {
      "path": "common.h",
      "text": "#pragma once\nint shared();\n",
      "markers": []
    },
    {
      "path": "main.cpp",
      "text": "#include \"a.h\"\n#include \"b.h\"\n\nint use() {\n    return shared();\n}\n",
      "markers": []
    }
  ],
  "tests": [
    {
      "name": "test",
      "blocks": [
        {
          "label": "main.cpp",
          "value": {
            "diagnostics": [
              {
                "at": {
                  "$place": "⟦#include \"b.h\"⟧",
                  "path": "main.cpp",
                  "range": {
                    "start": {
                      "line": 1,
                      "character": 0
                    },
                    "end": {
                      "line": 1,
                      "character": 14
                    }
                  }
                },
                "severity": "warning",
                "message": "Everything this file uses from \"b.h\" and the headers it includes comes from its other includes too",
                "source": "clice",
                "code": "unused-include",
                "tags": [
                  "Unnecessary"
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
