      "text": "#pragma once\n#include \"detail.h\"\n",
      "markers": []
    },
    {
      "path": "detail.h",
      "text": "#pragma once\nint detail_value();\n",
      "markers": []
    },
    {
      "path": "main.cpp",
      "text": "#include \"api.h\"\n#include \"unused.h\"\n\nint use() {\n    return detail_value();\n}\n",
      "markers": []
    },
    {
      "path": "unused.h",
      "text": "#pragma once\nint other();\n",
