{
  "id": "diagnostics/unused_includes/02_through_includes",
  "topic": "diagnostics",
  "subtopic": "unused_includes",
  "title": "Used through its includes",
  "summary": "An include the file reaches what it uses through counts as used",
  "prose": "A header that is the file's way to what it uses, as an umbrella or public entry header is, stays unreported though the file uses nothing it declares itself.",
  "status": "supported",
  "issues": [],
  "files": [
