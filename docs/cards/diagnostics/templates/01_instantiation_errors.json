{
  "id": "diagnostics/templates/01_instantiation_errors",
  "topic": "diagnostics",
  "subtopic": "templates",
  "title": "Errors in template instantiations",
  "summary": "An error inside a template shows where the code asks for the instantiation",
  "prose": "When a template fails for the arguments it is instantiated with, the error is reported on the code that requested the instantiation, not inside the template. Its notes lead through the chain of instantiations to the place in the template where it failed.",
  "status": "supported",
