{
  "id": "diagnostics/headers/01_errors_on_include",
  "topic": "diagnostics",
  "subtopic": "headers",
  "title": "Errors in included headers",
  "summary": "An error inside an included header shows on the line that includes it",
  "prose": "The first error of each included header is reported on its `#include` line, with a note at the place in the header where it occurred. The header's other errors belong to the header and show when it is opened.",
