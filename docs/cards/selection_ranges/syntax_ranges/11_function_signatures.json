{
  "id": "selection_ranges/syntax_ranges/11_function_signatures",
  "topic": "selection_ranges",
  "subtopic": "syntax_ranges",
  "title": "Function signatures",
  "summary": "A function's name is selected with its signature before the whole declaration",
  "prose": "The signature runs from the return type, or from the name of a\nconstructor, through the parameters and what the declaration adds after\nthem, such as `const noexcept`, a trailing return type, `override` or a\n`requires` clause.",
  "status": "supported",
  "issues": [],
