{
  "about": "v2.5.0 with its tests against Catch2 v3.9.1",
  "repository": "https://github.com/mpusz/mp-units",
  "commit": "27d2def9082ce00d7eb4f75695dbead4a748f23f",
  "configurations": {
    "modules": {
      "about": "built as C++20 modules; on Windows for MinGW, xclang's default, as clang rejects its std::format calls against MSVC's library",
      "prepare": [
        ["git", "init", "-q", "catch2-src"],
        [
          "git",
          "-C",
          "catch2-src",
          "fetch",
          "-q",
          "--depth",
          "1",
          "https://github.com/catchorg/Catch2",
          "644821ce28cb25d7992a4d0375b1d83214392592"
        ],
        ["git", "-C", "catch2-src", "checkout", "-q", "FETCH_HEAD"],
        [
          "cmake",
          "-S",
          "catch2-src",
          "-B",
          "catch2-build",
          "-G",
          "Ninja",
          "-DCMAKE_CXX_COMPILER=clang++",
          "-DCMAKE_INSTALL_PREFIX=${CHECKOUT}/catch2",
          "-DBUILD_TESTING=OFF"
        ],
        ["cmake", "--build", "catch2-build"],
        ["cmake", "--install", "catch2-build"],
        [
          "cmake",
          "-S",
          ".",
          "-B",
          "build",
          "-G",
          "Ninja",
          "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
          "-DCMAKE_C_COMPILER=clang",
          "-DCMAKE_CXX_COMPILER=clang++",
          "-DCMAKE_CXX_STANDARD=20",
          "-DCMAKE_PREFIX_PATH=${CHECKOUT}/catch2",
          "-DMP_UNITS_BUILD_CXX_MODULES=ON",
          "-DMP_UNITS_API_CONTRACTS=NONE",
          "-DMP_UNITS_API_STD_FORMAT=TRUE"
        ]
      ],
      "database": "build/compile_commands.json"
    }
  }
}
