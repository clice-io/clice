{
  "about": "12.2.0 with its tests, built as C++20",
  "repository": "https://github.com/fmtlib/fmt",
  "commit": "1be298e1bd68957e4cd352e1f676f00e07dcfb57",
  "configurations": {
    "clang": {
      "about": "built by clang",
      "prepare": [
        [
          "cmake",
          "-S",
          ".",
          "-B",
          "build",
          "-G",
          "Ninja",
          "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
          "${CMAKE_TOOLCHAIN}",
          "-DCMAKE_C_COMPILER=clang",
          "-DCMAKE_CXX_COMPILER=clang++",
          "-DCMAKE_CXX_STANDARD=20",
          "-DFMT_TEST=ON"
        ]
      ],
      "database": "build/compile_commands.json"
    },
    "msvc": {
      "about": "built by MSVC's cl, its database read by servers started without Visual Studio's environment, as an editor launched normally is",
      "platforms": ["windows"],
      "environment": "vcvars",
      "prepare": [
        [
          "cmake",
          "-S",
          ".",
          "-B",
          "build",
          "-G",
          "Ninja",
          "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
          "-DCMAKE_C_COMPILER=cl",
          "-DCMAKE_CXX_COMPILER=cl",
          "-DCMAKE_CXX_STANDARD=20",
          "-DFMT_TEST=ON"
        ]
      ],
      "database": "build/compile_commands.json"
    }
  }
}
