# SCM syntax highlighting & preventing 3-way merges
pixi.lock merge=binary linguist-language=YAML linguist-generated=true -diff

# Force LF line endings for the cases so that byte offsets from clang
# (which reads from disk) match the content sent by didOpen in tests.
tests/** text eol=lf
# Cases about CRLF line endings keep the bytes they are written in.
tests/compile/encoding/02_line_endings/*.h -text
tests/compile/encoding/02_line_endings/*.cpp -text
tests/format/document/06_crlf_line_endings/*.cpp -text
# A UTF-16 response file keeps its bytes.
tests/project/discovery/13_utf16_response_file/flags.rsp -text

# Treat trace files as binary to suppress text diffs
tests/**/trace.jsonl linguist-generated=true binary
# Generated feature docs are parsed by tools/testing/docs/site.ts marker regexes.
docs/**/*.md text eol=lf
# Every case run compares a documented case's card with its file byte for byte.
docs/cards/** text eol=lf
