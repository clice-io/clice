load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")
load("@xclang//bazel:debug_symbols.bzl", "xclang_debug_symbols")
load("@xclang//bazel:resource_dir.bzl", "xclang_resource_dir")

# What clice's own sources compile with; the libraries keep their own flags.
COPTS = [
    "-Isrc",
    "-fno-rtti",
    "-fno-exceptions",
    "-Werror=return-type",
    "-Wno-deprecated-declarations",
    "-Wno-undefined-inline",
]

# Link optimizations in optimized builds: what the test suites run is what
# releases ship. icf=safe (not =all) so address-taken functions keep C++
# pointer identity.
LINKOPTS = select({
    ":opt_macos": ["-Wl,--icf=safe"],
    ":opt": [
        "-Wl,--icf=safe",
        "-Wl,-O2",
    ],
    "//conditions:default": [],
})

config_setting(
    name = "opt",
    values = {"compilation_mode": "opt"},
)

config_setting(
    name = "opt_macos",
    constraint_values = ["@platforms//os:macos"],
    values = {"compilation_mode": "opt"},
)

# The LLVM and clang libraries clice links; each brings what it depends on.
LLVM_LIBRARIES = [
    "LLVMFrontendOpenMP",
    "LLVMOption",
    "LLVMSupport",
    "LLVMTargetParser",
    "clangAST",
    "clangASTMatchers",
    "clangBasic",
    "clangDriver",
    "clangFormat",
    "clangFrontend",
    "clangLex",
    "clangOptions",
    "clangSema",
    "clangSerialization",
    "clangTidy",
    "clangTidyAbseilModule",
    "clangTidyAlteraModule",
    "clangTidyAndroidModule",
    "clangTidyBoostModule",
    "clangTidyBugproneModule",
    "clangTidyCERTModule",
    "clangTidyConcurrencyModule",
    "clangTidyCppCoreGuidelinesModule",
    "clangTidyDarwinModule",
    "clangTidyFuchsiaModule",
    "clangTidyGoogleModule",
    "clangTidyLLVMLibcModule",
    "clangTidyLLVMModule",
    "clangTidyLinuxKernelModule",
    "clangTidyMiscModule",
    "clangTidyModernizeModule",
    "clangTidyObjCModule",
    "clangTidyOpenMPModule",
    "clangTidyPerformanceModule",
    "clangTidyPortabilityModule",
    "clangTidyReadabilityModule",
    "clangTidyUtils",
    "clangTidyZirconModule",
    "clangTooling",
    "clangToolingCore",
    "clangToolingInclusions",
    "clangToolingInclusionsStdlib",
    "clangToolingSyntax",
]

# libclang's ThinLTO bitcode (its ASan build in ASan builds): every link of
# it redoes LLVM's code generation, which lld's cache (.bazelrc) keeps from
# one link to the next.
cc_library(
    name = "llvm",
    deps = ["@libclang//:" + lib for lib in LLVM_LIBRARIES],
)

xclang_resource_dir(name = "resource_dir")

cc_library(
    name = "version",
    srcs = ["//bazel:version_cpp"],
    hdrs = ["src/version.h"],
    copts = COPTS,
)

# Layered libraries: core <- config <- {project, worker} <- sched <- server,
# and project <- analysis. Each layer may include downward only; the
# dependency graph plus the layering check in CI (`pixi run check-layers`)
# enforce the boundary — sched and below never see an LSP or server header,
# and a project never sees scheduling. They compile against libclang's
# headers; the programs link its libraries.
CORE = [
    "support",
    "vfs",
    "syntax",
    "command",
    "compile",
    "semantic",
    "index",
    "feature",
]

cc_library(
    name = "core",
    srcs = glob(["src/%s/**/*.cpp" % layer for layer in CORE]),
    hdrs = glob(["src/%s/**/*.h" % layer for layer in CORE] + ["src/compile/*.inc"]),
    copts = COPTS,
    deps = [
        ":version",
        "@libclang//:headers",
        "@croaring",
        "@kotatsu//:codec_flatbuffers",
        "@kotatsu//:codec_json",
        "@kotatsu//:codec_toml",
        "@kotatsu//:ipc_json",
        "@kotatsu//:ipc_lsp",
        "@kotatsu//:option",
        "@kotatsu//:support",
        "@lmdb",
        "@simdjson",
        "@spdlog",
    ],
)

[cc_library(
    name = layer,
    srcs = glob(["src/%s/**/*.cpp" % layer]),
    hdrs = glob(["src/%s/**/*.h" % layer]),
    copts = COPTS,
    deps = deps,
) for layer, deps in [
    ("config", [":core"]),
    ("project", [":config"]),
    ("worker", [":config"]),
    ("sched", [
        ":project",
        ":worker",
    ]),
    ("server", [
        ":sched",
        "@kotatsu//:deco",
    ]),
    ("analysis", [":project"]),
]]

# The programs are in bin/, next to the resource directory they read.
cc_binary(
    name = "bin/clice",
    srcs = ["src/clice.cc"] + glob(["src/driver/*"]) + select({
        "@platforms//os:windows": ["src/mimalloc.cc"],
        "//conditions:default": [],
    }),
    copts = COPTS,
    data = [":resource_dir"],
    # lld's --gc-sections, which xclang leaves off for Windows, where it
    # drops the initializers of variables no one reads that are COMDATs of
    # their own: neither program registers anything that way (zest keeps
    # its tests registered).
    features = [
        "gc_sections",
        "generate_dsym_file",
    ],
    linkopts = LINKOPTS,
    deps = [
        ":analysis",
        ":llvm",
        ":server",
        "@kotatsu//:deco",
    ] + select({
        "@platforms//os:windows": ["@mimalloc"],
        "//conditions:default": [],
    }),
)

cc_binary(
    name = "bin/unit_tests",
    srcs = [
        # The log level option, as the programs take it.
        "src/driver/driver.h",
        "tests/unit/test/tester.cpp",
        "tests/unit/unit_tests.cc",
    ] + glob([
        "tests/unit/*/*_tests.cpp",
        "tests/unit/**/*.h",
    ]),
    copts = COPTS + ["-Itests/unit"],
    data = [":resource_dir"],
    features = ["gc_sections"],
    linkopts = LINKOPTS,
    local_defines = ['CLICE_TESTS_DATA_DIR=\\"tests/data\\"'],
    deps = [
        ":llvm",
        ":server",
        "@kotatsu//:deco",
        "@kotatsu//:zest_async",
    ],
)

filegroup(
    name = "dist",
    srcs = [
        ":bin/clice",
        ":bin/unit_tests",
    ],
)

# The release archive, clice/{bin/clice, lib/clang, clice.toml, LICENSE}, and
# the symbol package, clice.gsym for scripts/symbolize.py: the programs of
# these builds are the ones the test suites run.
pkg_files(
    name = "package_bin",
    srcs = [":bin/clice.stripped"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "clice/bin",
    renames = select({
        "@platforms//os:windows": {":bin/clice.stripped": "clice.exe"},
        "//conditions:default": {":bin/clice.stripped": "clice"},
    }),
)

pkg_files(
    name = "package_resource_dir",
    srcs = [":resource_dir"],
    prefix = "clice",
    strip_prefix = strip_prefix.from_pkg(),
)

pkg_files(
    name = "package_docs",
    srcs = [
        "LICENSE",
        "docs/clice.toml",
    ],
    prefix = "clice",
)

PACKAGE = [
    ":package_bin",
    ":package_docs",
    ":package_resource_dir",
]

pkg_tar(
    name = "package_tar",
    srcs = PACKAGE,
    extension = "tar.gz",
    package_file_name = "clice.tar.gz",
    tags = ["manual"],
)

pkg_zip(
    name = "package_zip",
    srcs = PACKAGE,
    package_file_name = "clice.zip",
    tags = ["manual"],
)

alias(
    name = "package",
    actual = select({
        "@platforms//os:windows": ":package_zip",
        "//conditions:default": ":package_tar",
    }),
)

# The GSYM, and the dSYM it comes from on macOS. --merged-functions keeps the
# names of the functions ICF folded; one thread makes the file the same
# bytes every time.
xclang_debug_symbols(
    name = "debug_symbols",
    binary = ":bin/clice",
    gsymutil_args = [
        "--merged-functions",
        "--num-threads=1",
    ],
    tags = ["manual"],
)

filegroup(
    name = "gsym",
    srcs = [":debug_symbols"],
    output_group = "gsym",
    tags = ["manual"],
)

pkg_tar(
    name = "symbols_tar",
    srcs = [":gsym"],
    extension = "tar.xz",
    package_file_name = "clice-symbol.tar.xz",
    tags = ["manual"],
)

pkg_zip(
    name = "symbols_zip",
    srcs = [":gsym"],
    package_file_name = "clice-symbol.zip",
    tags = ["manual"],
)

alias(
    name = "symbols",
    actual = select({
        "@platforms//os:windows": ":symbols_zip",
        "//conditions:default": ":symbols_tar",
    }),
)

BENCHMARKS = [
    "index_stats_benchmark",
    "pch_chain_benchmark",
    "pipeline_benchmark",
    "scan_benchmark",
]

[cc_binary(
    name = "bin/" + benchmark,
    srcs = [
        "benchmarks/%s.cpp" % benchmark,
        "benchmarks/stats.h",
    ],
    copts = COPTS,
    data = [":resource_dir"],
    linkopts = LINKOPTS,
    tags = ["manual"],
    deps = [
        ":llvm",
        ":server",
        "@kotatsu//:deco",
    ],
) for benchmark in BENCHMARKS]

filegroup(
    name = "benchmarks",
    srcs = ["bin/" + benchmark for benchmark in BENCHMARKS],
    tags = ["manual"],
)
