load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@xclang//bazel:resource_dir.bzl", "xclang_resource_dir")
load("//bazel:defs.bzl", "CLICE_COPTS", "COPTS", "LINKOPTS", "release_packages")

xclang_resource_dir(name = "resource_dir")

# The builtin headers of the resource directory, each as BUILTIN_HEADER(name,
# kind) by its path below include/, sorted: Internal for one that says it
# must not be included directly ("Never use <avxintrin.h> directly"), Public
# for the rest. An upgrade of xclang regenerates it.
genrule(
    name = "builtin_headers_inc",
    srcs = [":resource_dir"],
    outs = ["builtin_headers.inc"],
    cmd = """
for f in $(SRCS); do
  case "$$f" in */lib/clang/*/include/*) ;; *) continue ;; esac
  if grep -q 'Never use <[^>]*> directly' "$$f"; then kind=Internal; else kind=Public; fi
  echo "BUILTIN_HEADER(\\"$${f#*/lib/clang/*/include/}\\", $$kind)"
done | LC_ALL=C sort > $@
""",
)

cc_library(
    name = "version",
    srcs = ["//bazel:version_cpp"],
    hdrs = ["src/version.h"],
    copts = COPTS,
)

# Layered libraries: core <- settings <- worker <- project <- {server,
# analysis} <- driver. Each layer may include or import downward only; the
# dependency graph plus the layering check in CI (`pixi run check-layers`)
# enforce the boundary — the project and below never see an LSP or server
# header, and analysis never reaches the workers. Inside core the directories are
# layered in this order, which only the check enforces. They compile against
# libclang's headers; the programs link its libraries. All of clice is one
# C++20 module, clice: each header is a partition (<stem>.cppm beside its
# source) and each source an implementation unit; the primary interface,
# src/module.cppm, re-exports only the prelude, which exports nothing, and
# sits in the lowest library.
CORE = [
    "support",
    "vfs",
    "command",
    "syntax",
    "compile",
    "semantic",
    "index",
    "feature",
]

cc_library(
    name = "core",
    srcs = glob(["src/%s/**/*.cpp" % layer for layer in CORE]),
    hdrs = glob(
        ["src/%s/**/*.%s" % (layer, suffix) for layer in CORE for suffix in ["h", "inc"]],
        allow_empty = True,
    ) + [":builtin_headers_inc"],
    copts = CLICE_COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["src/module.cppm"] + glob(["src/%s/**/*.cppm" % layer for layer in CORE]),
    deps = [
        ":version",
        "//modules",
    ],
)

[cc_library(
    name = layer,
    srcs = glob(
        [
            "src/%s/**/*.cpp" % layer,
            "src/%s/**/*.cc" % layer,
        ],
        allow_empty = True,
    ),
    # The subcommands register themselves (src/driver/driver.cppm), and
    # nothing names their files.
    alwayslink = layer == "driver",
    copts = CLICE_COPTS,
    features = ["cpp_modules"],
    module_interfaces = glob(["src/%s/**/*.cppm" % layer]),
    deps = deps,
) for layer, deps in [
    ("settings", [":core"]),
    ("worker", [":settings"]),
    ("project", [":worker"]),
    ("server", [":project"]),
    ("analysis", [":project"]),
    ("driver", [
        ":analysis",
        ":server",
    ]),
]]

# The allocator of the Windows and macOS executables, no part of the module:
# it includes the standard headers as they are.
cc_library(
    name = "allocator",
    srcs = ["src/mimalloc.cc"],
    copts = COPTS,
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["@mimalloc"],
    alwayslink = True,
)

# The programs are in bin/, next to the resource directory they read.
cc_binary(
    name = "bin/clice",
    srcs = ["src/clice.cc"],
    copts = CLICE_COPTS,
    data = [":resource_dir"],
    # lld's --gc-sections, which xclang leaves off for Windows, where it
    # drops the initializers of variables no one reads that are COMDATs of
    # their own: the subcommands register from ordinary variables, and zest
    # keeps its tests registered.
    features = [
        "cpp_modules",
        "gc_sections",
        "generate_dsym_file",
    ],
    linkopts = LINKOPTS,
    deps = [
        ":driver",
        "//bazel:llvm",
    ] + select({
        "@platforms//os:macos": [":allocator"],
        "@platforms//os:windows": [":allocator"],
        "//conditions:default": [],
    }),
)

# The test helpers: partitions of clice too, which the tests import.
cc_library(
    name = "unit_test_support",
    srcs = [
        "unittests/utils/annotation.cpp",
        "unittests/utils/tester.cpp",
    ],
    copts = CLICE_COPTS,
    features = ["cpp_modules"],
    module_interfaces = glob(["unittests/**/*.cppm"]),
    deps = [":driver"],
)

cc_binary(
    name = "bin/unittests",
    srcs = ["unittests/main.cc"] + glob(["unittests/**/*_tests.cpp"]),
    copts = CLICE_COPTS,
    data = [":resource_dir"],
    features = [
        "cpp_modules",
        "gc_sections",
    ],
    linkopts = LINKOPTS,
    deps = [
        ":unit_test_support",
        "//bazel:llvm",
    ],
)

filegroup(
    name = "dist",
    srcs = [
        ":bin/clice",
        ":bin/unittests",
    ],
)

release_packages()
