load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:dist.bzl", "clice_dist")

# clice_options of CMakeLists.txt.
COPTS = [
    "-fno-rtti",
    "-fno-exceptions",
    "-Wno-deprecated-declarations",
    "-Wno-undefined-inline",
]

DEFINES = ["CLICE_ENABLE_TEST=1"]

TRIPLES = {
    "linux_x86_64": "x86_64-unknown-linux-gnu",
    "linux_aarch64": "aarch64-unknown-linux-gnu",
    "macos_x86_64": "x86_64-apple-darwin",
    "macos_aarch64": "aarch64-apple-darwin",
    "windows_x86_64": "x86_64-w64-mingw32",
    "windows_aarch64": "aarch64-w64-mingw32",
}

# Stamped from bazel/workspace_status.sh; rebuilt when the version changes.
genrule(
    name = "version_h",
    srcs = ["cmake/version.h.in"],
    outs = ["generated/version.h"],
    cmd = select({
        "//bazel:" + setting: (
            "version=$$(sed -n 's/^STABLE_CLICE_VERSION //p' bazel-out/stable-status.txt); " +
            "sed -e \"s|@CLICE_VERSION_STRING@|$${version:-0.1.0}|\" " +
            "-e 's|@CLICE_TARGET_STRING@|%s|' $< > $@" % triple
        )
        for setting, triple in TRIPLES.items()
    }),
    stamp = 1,
)

cc_library(
    name = "version",
    hdrs = [":version_h"],
    strip_include_prefix = "generated",
)

cc_library(
    name = "clang_tidy_config",
    hdrs = ["cmake/clang-tidy-config.h"],
    strip_include_prefix = "cmake",
)

# Layered targets: core <- config <- {project, worker} <- sched <- server.
CORE_DIRS = ["support", "vfs", "syntax", "command", "compile", "semantic", "index", "feature"]

cc_library(
    name = "core",
    srcs = glob(["src/%s/**/*.cpp" % d for d in CORE_DIRS], allow_empty = True),
    hdrs = glob(["src/%s/**/*.h" % d for d in CORE_DIRS] + ["src/%s/**/*.inc" % d for d in CORE_DIRS], allow_empty = True),
    copts = COPTS,
    defines = DEFINES,
    includes = ["src"],
    deps = [
        ":clang_tidy_config",
        ":version",
        "@croaring",
        "@kotatsu//:codec_flatbuffers",
        "@kotatsu//:codec_toml",
        "@kotatsu//:ipc_lsp",
        "@kotatsu//:option",
        "@kotatsu//:support",
        "@llvm",
        "@lmdb",
        "@simdjson",
        "@spdlog",
    ],
)

[cc_library(
    name = layer,
    srcs = glob(["src/%s/**/*.cpp" % layer], allow_empty = True),
    hdrs = glob(["src/%s/**/*.h" % layer], allow_empty = True),
    copts = COPTS,
    deps = deps,
) for layer, deps in [
    ("config", [":core"]),
    ("project", [":config"]),
    ("worker", [":config"]),
    ("sched", [":project", ":worker"]),
    ("server", [":sched"]),
]]

cc_binary(
    name = "clice",
    srcs = ["src/clice.cc"] + glob(["src/driver/*.cc", "src/driver/*.h"], allow_empty = True) + select({
        "@platforms//os:windows": ["src/mimalloc.cc"],
        "//conditions:default": [],
    }),
    copts = COPTS,
    linkopts = select({
        "@platforms//os:windows": ["-Wl,--allow-multiple-definition"],
        "//conditions:default": [],
    }),
    deps = [
        ":server",
        "@kotatsu//:deco",
    ] + select({
        "@platforms//os:windows": ["@mimalloc"],
        "//conditions:default": [],
    }),
)

cc_binary(
    name = "unit_tests",
    srcs = [
        "tests/unit/test/tester.cpp",
        "tests/unit/unit_tests.cc",
    ] + glob([
        "tests/unit/*/*_tests.cpp",
        "tests/unit/**/*.h",
    ], allow_empty = True),
    copts = COPTS + ["-Itests/unit"],
    linkopts = select({
        "@platforms//os:windows": ["-Wl,--allow-multiple-definition"],
        "//conditions:default": [],
    }),
    local_defines = ['CLICE_TESTS_DATA_DIR=\\"tests/data\\"'],
    deps = [
        ":server",
        "@kotatsu//:deco",
        "@kotatsu//:zest",
    ],
)

# build/<type>/{bin,lib} of the CMake build.
clice_dist(
    name = "dist",
    binaries = [
        ":clice",
        ":unit_tests",
    ],
    resource_dir = "@llvm//:resource_dir",
)

sh_test(
    name = "unit_tests_test",
    size = "medium",
    srcs = ["//bazel:unit_tests.sh"],
    args = ["--verbose"],
    data = [":dist"] + glob(["tests/data/**"]),
)
