load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@xclang//bazel:resource_dir.bzl", "xclang_resource_dir")
load("//bazel:defs.bzl", "COPTS", "LINKOPTS", "benchmark_programs", "release_packages")

xclang_resource_dir(name = "resource_dir")

cc_library(
    name = "version",
    srcs = ["//bazel:version_cpp"],
    hdrs = ["src/version.h"],
    copts = COPTS,
    features = ["cpp_modules"],
    deps = ["//modules"],
)

# Layered libraries: core <- config <- {project, worker} <- sched <- server,
# and project <- analysis. Each layer may include downward only; the
# dependency graph plus the layering check in CI (`pixi run check-layers`)
# enforce the boundary — sched and below never see an LSP or server header,
# and a project never sees scheduling. Inside core the directories are
# layered in this order, which only the check enforces. They compile against
# libclang's headers; the programs link its libraries.
CORE = [
    "support",
    "vfs",
    "command",
    "syntax",
    "semantic",
    "compile",
    "index",
    "feature",
]

cc_library(
    name = "core",
    srcs = glob(["src/%s/**/*.cpp" % layer for layer in CORE]),
    hdrs = glob(["src/%s/**/*.h" % layer for layer in CORE] + ["src/compile/*.inc"]),
    copts = COPTS,
    features = ["cpp_modules"],
    deps = [
        ":version",
        "//modules",
        "@libclang//:headers",
        "@croaring",
        "@kotatsu//:codec_flatbuffers",
        "@kotatsu//:codec_json",
        "@kotatsu//:codec_toml",
        "@kotatsu//:ipc_json",
        "@kotatsu//:ipc_lsp",
        "@kotatsu//:option",
        "@kotatsu//:support",
        "@lmdb",
        "@simdjson",
        "@spdlog",
    ],
)

[cc_library(
    name = layer,
    srcs = glob(["src/%s/**/*.cpp" % layer]),
    hdrs = glob(["src/%s/**/*.h" % layer]),
    copts = COPTS,
    features = ["cpp_modules"],
    deps = deps,
) for layer, deps in [
    ("config", [":core"]),
    ("project", [":config"]),
    ("worker", [":config"]),
    ("sched", [
        ":project",
        ":worker",
    ]),
    ("server", [
        ":sched",
        "@kotatsu//:deco",
    ]),
    ("analysis", [":project"]),
]]

# The programs are in bin/, next to the resource directory they read.
cc_binary(
    name = "bin/clice",
    srcs = ["src/clice.cc"] + glob(["src/driver/*"]) + select({
        "@platforms//os:windows": ["src/mimalloc.cc"],
        "//conditions:default": [],
    }),
    copts = COPTS,
    data = [":resource_dir"],
    # lld's --gc-sections, which xclang leaves off for Windows, where it
    # drops the initializers of variables no one reads that are COMDATs of
    # their own: neither program registers anything that way (zest keeps
    # its tests registered).
    features = [
        "cpp_modules",
        "gc_sections",
        "generate_dsym_file",
    ],
    linkopts = LINKOPTS,
    deps = [
        ":analysis",
        ":server",
        "//bazel:llvm",
        "@kotatsu//:deco",
    ] + select({
        "@platforms//os:windows": ["@mimalloc"],
        "//conditions:default": [],
    }),
)

cc_binary(
    name = "bin/unit_tests",
    srcs = [
        # The log level option, as the programs take it.
        "src/driver/driver.h",
        "tests/unit/test/tester.cpp",
        "tests/unit/unit_tests.cc",
    ] + glob([
        "tests/unit/*/*_tests.cpp",
        "tests/unit/**/*.h",
    ]),
    copts = COPTS + ["-Itests/unit"],
    data = [":resource_dir"],
    features = [
        "cpp_modules",
        "gc_sections",
    ],
    linkopts = LINKOPTS,
    local_defines = ['CLICE_TESTS_DATA_DIR=\\"tests/data\\"'],
    deps = [
        ":server",
        "//bazel:llvm",
        "@kotatsu//:deco",
        "@kotatsu//:zest_async",
    ],
)

filegroup(
    name = "dist",
    srcs = [
        ":bin/clice",
        ":bin/unit_tests",
    ],
)

release_packages()

# The component benchmarks (benchmarks/README.md), built on request.
benchmark_programs([
    "index_stats_benchmark",
    "pch_chain_benchmark",
    "pipeline_benchmark",
    "scan_benchmark",
])
