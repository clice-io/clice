module;

#include "modules/prelude.h"

module clice:unittests.worker.workloads;

namespace clice::testing {

/// A translation unit as the simulator runs it: its CPU seconds alone on one
/// core, and the peak of its worker's own memory in MiB.
struct UnitLoad {
    double seconds = 0;
    std::uint32_t peak = 0;
};

/// LLVM 23.1.3 flang's eight heaviest units, one at a time on a 4-vCPU
/// (2 cores x 2 threads) Linux box, no PCH shared: fold-integer,
/// fold-logical, fold-real, Bridge, ConvertExpr, OpenACC, resolve-names,
/// FrontendActions.
constexpr inline UnitLoad flang_heavy[] = {
    {31, 2843},
    {26, 2495},
    {28, 2556},
    {43, 4271},
    {42, 4058},
    {39, 3923},
    {38, 3654},
    {52, 4911},
};

