common --enable_platform_specific_config
# xclang, kotatsu and the third-party libraries come from the clice Bazel
# registry, the rest from the Bazel Central Registry.
common --registry=https://bazel.clice.io/
common --registry=https://bcr.bazel.build/
# The C++ toolchain is xclang's (MODULE.bazel), on every platform; rules_cc's
# detection of another is off.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --cxxopt=-std=c++23 --host_cxxopt=-std=c++23
common:macos --macos_minimum_os=15.0

# clice builds without exceptions or RTTI, and its libraries are configured
# to match; spdlog formats with std::format.
common --@kotatsu//bazel:exceptions=false --@kotatsu//bazel:rtti=false
common --@simdjson//:exceptions=false
common --@spdlog//:std_format=true --@spdlog//:exceptions=false
# The allocator of the Windows executable (src/mimalloc.cc) leaves its memory
# to the process exit.
common --@mimalloc//:skip_collect_on_exit=true

# The build types, each in a directory of its own: build/<type>/bin is
# Bazel's output tree of it, clice and unit_tests in its bin/, clang's
# resource directory in its lib/. RelWithDebInfo is the default;
# `--config=Debug` is an ASan build where xclang has the ASan libclang (Linux
# x64, macOS arm64), a plain debug build on Windows.
common -c opt --copt=-g --symlink_prefix=build/RelWithDebInfo/
common:RelWithDebInfo -c opt
common:Debug -c dbg --features=asan --symlink_prefix=build/Debug/
common:windows --features=-asan

# libclang is ThinLTO bitcode, whose code generation every link redoes
# (minutes) unless lld's cache has it. The cache's path is in the link's
# action key, so it is one path everywhere; lld creates it, under a
# directory the Linux sandbox lets actions write to.
common:linux --linkopt=-Wl,--thinlto-cache-dir=/var/tmp/xclang-thinlto
common:linux --sandbox_writable_path=/var/tmp
common:macos --linkopt=-Wl,-cache_path_lto,/var/tmp/xclang-thinlto
common:windows --linkopt=-Wl,--thinlto-cache-dir=C:/xclang-thinlto

# How //:package strips clice.
common:linux --stripopt=--strip-unneeded
common:macos --stripopt=-x
common:windows --stripopt=--strip-unneeded

# version.cpp, stamped with the version git describes.
common --workspace_status_command="node bazel/workspace_status.mjs"

# A local file of one's own (a disk cache, say), never committed.
try-import %workspace%/user.bazelrc
