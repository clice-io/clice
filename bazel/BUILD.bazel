load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//:__pkg__"])

config_setting(
    name = "opt",
    values = {"compilation_mode": "opt"},
)

config_setting(
    name = "opt_macos",
    constraint_values = ["@platforms//os:macos"],
    values = {"compilation_mode": "opt"},
)

# The LLVM and clang libraries clice links; each brings what it depends on.
# LIMITATION: no target's MC layer is linked, so MS-style inline assembly
# (`__asm { ... }`, 32-bit MSVC targets only) is an error ("no targets are
# registered") in its file and every includer, and its references are lost.
LLVM_LIBRARIES = [
    "LLVMFrontendOpenMP",
    "LLVMOption",
    "LLVMSupport",
    "LLVMTargetParser",
    "LLVMWindowsDriver",
    "clangAST",
    "clangASTMatchers",
    "clangBasic",
    "clangDriver",
    "clangFormat",
    "clangFrontend",
    "clangLex",
    "clangOptions",
    "clangSema",
    "clangSerialization",
    "clangTidy",
    "clangTidyAbseilModule",
    "clangTidyAlteraModule",
    "clangTidyAndroidModule",
    "clangTidyBoostModule",
    "clangTidyBugproneModule",
    "clangTidyCERTModule",
    "clangTidyConcurrencyModule",
    "clangTidyCppCoreGuidelinesModule",
    "clangTidyDarwinModule",
    "clangTidyFuchsiaModule",
    "clangTidyGoogleModule",
    "clangTidyLLVMLibcModule",
    "clangTidyLLVMModule",
    "clangTidyLinuxKernelModule",
    "clangTidyMiscModule",
    "clangTidyModernizeModule",
    "clangTidyObjCModule",
    "clangTidyOpenMPModule",
    "clangTidyPerformanceModule",
    "clangTidyPortabilityModule",
    "clangTidyReadabilityModule",
    "clangTidyUtils",
    "clangTidyZirconModule",
    "clangTooling",
    "clangToolingCore",
    "clangToolingInclusions",
    "clangToolingInclusionsStdlib",
    "clangToolingSyntax",
]

# libclang's ThinLTO bitcode: every link of it redoes LLVM's code
# generation, which lld's cache (clice.bazelrc) keeps from one link to the
# next.
cc_library(
    name = "llvm",
    deps = ["@libclang//:" + lib for lib in LLVM_LIBRARIES],
)

# The canonical target triples, by the os, cpu and C library of their
# platforms: the release assets are named after them, and the version
# carries the one of the build.
TRIPLES = {
    "x86_64-unknown-linux-gnu": ("linux", "x86_64", "glibc"),
    "aarch64-unknown-linux-gnu": ("linux", "aarch64", "glibc"),
    "x86_64-unknown-linux-musl": ("linux", "x86_64", "musl"),
    "aarch64-unknown-linux-musl": ("linux", "aarch64", "musl"),
    "x86_64-apple-darwin": ("macos", "x86_64", "macosx"),
    "aarch64-apple-darwin": ("macos", "aarch64", "macosx"),
    "x86_64-w64-mingw32": ("windows", "x86_64", "mingw"),
    "aarch64-w64-mingw32": ("windows", "aarch64", "mingw"),
}

[config_setting(
    name = triple,
    constraint_values = [
        "@platforms//os:" + os,
        "@platforms//cpu:" + cpu,
        "@xclang//platforms/libc:" + libc,
    ],
) for triple, (os, cpu, libc) in TRIPLES.items()]

# Stamped from bazel/workspace_status.mjs: the one source whose compile a new
# version reruns (src/support/version.cppm).
genrule(
    name = "version_cpp",
    outs = ["version.cpp"],
    cmd = select({
        ":" + triple: """
version=$$(sed -n 's/^STABLE_CLICE_VERSION //p' bazel-out/stable-status.txt)
commit=$$(sed -n 's/^STABLE_CLICE_COMMIT //p' bazel-out/stable-status.txt)
cat > $@ <<EOF
#include <string_view>

namespace clice {

extern const std::string_view version = "$$version";
extern const std::string_view commit = "$$commit";
extern const std::string_view target = "%s";

}  // namespace clice
EOF
""" % triple
        for triple in TRIPLES
    }),
    stamp = 1,
)
