{
  "projects": [
    {
      "name": "llvm",
      "about": "llvmorg-23.1.3: eight subprojects, generated headers built, optional libraries off (the compiler's sysroot has none)",
      "repository": "https://github.com/llvm/llvm-project",
      "commit": "0d261d1ca552c95a8f007e061c787ac7132fbcbc",
      "prepare": [
        [
          "cmake",
          "-S",
          "llvm",
          "-B",
          "build",
          "-G",
          "Ninja",
          "-DCMAKE_BUILD_TYPE=Release",
          "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
          "-DCMAKE_C_COMPILER=clang",
          "-DCMAKE_CXX_COMPILER=clang++",
          "-DLLVM_ENABLE_PROJECTS=clang;clang-tools-extra;lld;lldb;mlir;polly;flang;bolt",
          "-DLLVM_ENABLE_ZLIB=OFF",
          "-DLLVM_ENABLE_ZSTD=OFF",
          "-DLLVM_ENABLE_LIBXML2=OFF",
          "-DLLVM_ENABLE_TERMINFO=OFF",
          "-DLLVM_ENABLE_LIBEDIT=OFF",
          "-DLLVM_ENABLE_LIBPFM=OFF",
          "-DLLVM_ENABLE_FFI=OFF",
          "-DLLVM_ENABLE_CURL=OFF",
          "-DLLVM_ENABLE_HTTPLIB=OFF",
          "-DLLDB_ENABLE_LIBEDIT=OFF",
          "-DLLDB_ENABLE_CURSES=OFF",
          "-DLLDB_ENABLE_LZMA=OFF",
          "-DLLDB_ENABLE_PYTHON=OFF",
          "-DLLDB_ENABLE_LUA=OFF",
          "-DLLDB_ENABLE_LIBXML2=OFF"
        ],
        { "generated": "build" }
      ],
      "database": "build/compile_commands.json",
      "parts": {
        "llvm": ["llvm/", "third-party/", "build/"],
        "clang": ["clang/", "clang-tools-extra/"],
        "mlir": ["mlir/", "flang/"],
        "lldb": ["lldb/", "lld/", "bolt/", "polly/"]
      },
      "sample": 40
    },
    {
      "name": "linux",
      "about": "v7.2, x86_64 defconfig, built in full: the database comes from the build's command files",
      "repository": "https://github.com/torvalds/linux",
      "commit": "8d3ae59288f1e7d58d76558a6ee96d533bc5019f",
      "packages": ["libelf-dev"],
      "prepare": [
        ["make", "LLVM=1", "HOSTCC=gcc", "HOSTCXX=g++", "defconfig"],
        ["make", "LLVM=1", "HOSTCC=gcc", "HOSTCXX=g++", "-j${JOBS}"],
        ["make", "LLVM=1", "HOSTCC=gcc", "HOSTCXX=g++", "compile_commands.json"]
      ],
      "database": "compile_commands.json",
      "sample": 40
    },
    {
      "name": "clice",
      "about": "clice itself at the commit under test: one C++23 module, its database from Bazel",
      "prepare": [
        [
          "npx",
          "bazel",
          "run",
          "@compdb//:refresh",
          "--",
          "--output_groups=+compilation_prerequisites_INTERNAL_"
        ]
      ],
      "database": "compile_commands.json",
      "sample": 20
    },
    {
      "name": "abseil",
      "about": "20260817.0 with its tests, built as C++20",
      "repository": "https://github.com/abseil/abseil-cpp",
      "commit": "2065f4ded0558c6f89fee67c8e5228feb4eb960e",
      "prepare": [
        [
          "cmake",
          "-S",
          ".",
          "-B",
          "build",
          "-G",
          "Ninja",
          "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
          "-DCMAKE_C_COMPILER=clang",
          "-DCMAKE_CXX_COMPILER=clang++",
          "-DCMAKE_CXX_STANDARD=20",
          "-DABSL_BUILD_TESTING=ON",
          "-DABSL_GOOGLETEST_DOWNLOAD_URL=https://github.com/google/googletest/archive/52eb8108c5bdec04579160ae17225d66034bd723.zip"
        ]
      ],
      "database": "build/compile_commands.json",
      "sample": 40
    },
    {
      "name": "mp-units",
      "about": "v2.5.0 built as C++20 modules, with its tests against Catch2 v3.9.1",
      "repository": "https://github.com/mpusz/mp-units",
      "commit": "27d2def9082ce00d7eb4f75695dbead4a748f23f",
      "prepare": [
        ["git", "init", "-q", "catch2-src"],
        [
          "git",
          "-C",
          "catch2-src",
          "fetch",
          "-q",
          "--depth",
          "1",
          "https://github.com/catchorg/Catch2",
          "644821ce28cb25d7992a4d0375b1d83214392592"
        ],
        ["git", "-C", "catch2-src", "checkout", "-q", "FETCH_HEAD"],
        [
          "cmake",
          "-S",
          "catch2-src",
          "-B",
          "catch2-build",
          "-G",
          "Ninja",
          "-DCMAKE_CXX_COMPILER=clang++",
          "-DCMAKE_INSTALL_PREFIX=${CHECKOUT}/catch2",
          "-DBUILD_TESTING=OFF"
        ],
        ["cmake", "--build", "catch2-build"],
        ["cmake", "--install", "catch2-build"],
        [
          "cmake",
          "-S",
          ".",
          "-B",
          "build",
          "-G",
          "Ninja",
          "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
          "-DCMAKE_C_COMPILER=clang",
          "-DCMAKE_CXX_COMPILER=clang++",
          "-DCMAKE_PREFIX_PATH=${CHECKOUT}/catch2",
          "-DMP_UNITS_BUILD_CXX_MODULES=ON",
          "-DMP_UNITS_API_CONTRACTS=NONE",
          "-DMP_UNITS_API_STD_FORMAT=TRUE"
        ]
      ],
      "database": "build/compile_commands.json",
      "sample": 20
    }
  ]
}
