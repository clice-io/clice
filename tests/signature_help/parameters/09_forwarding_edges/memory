#pragma once

namespace std {
template <class T>
struct unique_ptr {};

template <class T, class... Args>
unique_ptr<T> make_unique(Args&&... args);

template <class T>
class initializer_list {
    const T* first;
    const T* last;
};

template <bool Condition, class T>
struct enable_if {};

template <class T>
struct enable_if<true, T> {
    using type = T;
};

template <bool Condition, class T>
using enable_if_t = typename enable_if<Condition, T>::type;

template <class T, class... Args>
inline constexpr bool is_constructible_v = __is_constructible(T, Args...);

template <class T>
class optional {
public:
    using value_type = T;

    template <class... Args>
    enable_if_t<is_constructible_v<T, Args...>, T&> emplace(Args&&... args);

    template <class U, class... Args>
    T& emplace(initializer_list<U> list, Args&&... args);
};

template <class T>
class vector {
public:
    using value_type = T;
    using reference = T&;

    template <class... Args>
    reference emplace_back(Args&&... args);
};
}  // namespace std
