{
  // plain.c and palette.c are C: the names of C++ namespaces are none of
  // their business, the enumerators of a C header are.
  // inc holds a header only the library itself includes.
  "flags": ["-Iinc"],
  "units": {
    "main.cpp": [],
    "shapes.cpp": [],
    "tools.cppm": [],
    "plain.c": ["-std=c17"],
    "palette.c": ["-std=c17"]
  }
}
