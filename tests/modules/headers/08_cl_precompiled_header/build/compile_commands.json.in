[
  {
    "directory": "${WS}/build",
    "command": "clang++ --driver-mode=cl /nologo /TP /std:c++20 /Yc${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx /Fp${WS}/build/CMakeFiles/app.dir/cmake_pch.cxx.pch /FI${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx /FoCMakeFiles/app.dir/cmake_pch.cxx.obj -c ${WS}/build/CMakeFiles/app.dir/cmake_pch.cxx",
    "file": "${WS}/build/CMakeFiles/app.dir/cmake_pch.cxx",
    "output": "CMakeFiles/app.dir/cmake_pch.cxx.obj"
  },
  {
    "directory": "${WS}/build",
    "command": "clang++ --driver-mode=cl /nologo /TP /std:c++20 /Yu${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx /Fp${WS}/build/CMakeFiles/app.dir/cmake_pch.cxx.pch /FI${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx /FoCMakeFiles/app.dir/src/counting.cppm.obj -c ${WS}/src/counting.cppm",
    "file": "${WS}/src/counting.cppm",
    "output": "CMakeFiles/app.dir/src/counting.cppm.obj"
  },
  {
    "directory": "${WS}/build",
    "command": "clang++ --driver-mode=cl /nologo /TP /std:c++20 /Yu${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx /Fp${WS}/build/CMakeFiles/app.dir/cmake_pch.cxx.pch /FI${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx /FoCMakeFiles/app.dir/src/main.cpp.obj -c ${WS}/src/main.cpp",
    "file": "${WS}/src/main.cpp",
    "output": "CMakeFiles/app.dir/src/main.cpp.obj"
  }
]
