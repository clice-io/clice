[
  {
    "directory": "${WS}",
    "file": "kernels.cuh",
    "command": "nvcc-missing -ccbin g++ --cuda-path=${WS}/missing-cuda -c kernels.cuh -o kernels.o"
  },
  {
    "directory": "${WS}",
    "file": "app.rc",
    "command": "rc /fo app.res app.rc"
  },
  {
    "directory": "${WS}",
    "file": "a.ino",
    "command": "missing-clang++ -std=c++20 -x c++ -c a.ino"
  },
  {
    "directory": "${WS}",
    "file": "b.ino",
    "command": "missing-clang++ -std=c++20 -c b.ino"
  }
]
