[
  {
    "directory": "${WS}/build",
    "command": "clang++ -I${WS}/include -std=c++20 -fpch-instantiate-templates -Xclang -emit-pch -Xclang -include -Xclang ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx -x c++-header -o CMakeFiles/app.dir/cmake_pch.hxx.pch -c ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx.cxx",
    "file": "${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx.cxx",
    "output": "CMakeFiles/app.dir/cmake_pch.hxx.pch"
  },
  {
    "directory": "${WS}/build",
    "command": "clang++ -I${WS}/include -std=c++20 -Winvalid-pch -Xclang -include-pch -Xclang ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx.pch -Xclang -include -Xclang ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx -o CMakeFiles/app.dir/src/main.cpp.o -c ${WS}/src/main.cpp",
    "file": "${WS}/src/main.cpp",
    "output": "CMakeFiles/app.dir/src/main.cpp.o"
  },
  {
    "directory": "${WS}/build",
    "command": "clang++ -I${WS}/include -std=c++20 -Winvalid-pch -Xclang -include-pch -Xclang ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx.pch -Xclang -include -Xclang ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx -o CMakeFiles/app.dir/src/area.cpp.o -c ${WS}/src/area.cpp",
    "file": "${WS}/src/area.cpp",
    "output": "CMakeFiles/app.dir/src/area.cpp.o"
  }
]
