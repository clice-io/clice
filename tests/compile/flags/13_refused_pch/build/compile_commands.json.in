[
  {
    "directory": "${WS}/build",
    "command": "clang++ -I${WS}/include -std=c++20 -DLEVEL=1 -fpch-instantiate-templates -Xclang -emit-pch -Xclang -include -Xclang ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx -x c++-header -o CMakeFiles/app.dir/cmake_pch.hxx.pch -c ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx.cxx",
    "file": "${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx.cxx",
    "output": "CMakeFiles/app.dir/cmake_pch.hxx.pch"
  },
  {
    "directory": "${WS}/build",
    "command": "clang++ -I${WS}/include -std=c++20 -DLEVEL=2 -Winvalid-pch -Xclang -include-pch -Xclang ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx.pch -Xclang -include -Xclang ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx -o CMakeFiles/app.dir/main.cpp.o -c ${WS}/main.cpp",
    "file": "${WS}/main.cpp",
    "output": "CMakeFiles/app.dir/main.cpp.o"
  },
  {
    "directory": "${WS}/build",
    "command": "clang++ -I${WS}/include -std=c++23 -DLEVEL=1 -Winvalid-pch -Xclang -include-pch -Xclang ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx.pch -Xclang -include -Xclang ${WS}/build/CMakeFiles/app.dir/cmake_pch.hxx -o CMakeFiles/app.dir/other.cpp.o -c ${WS}/other.cpp",
    "file": "${WS}/other.cpp",
    "output": "CMakeFiles/app.dir/other.cpp.o"
  }
]
