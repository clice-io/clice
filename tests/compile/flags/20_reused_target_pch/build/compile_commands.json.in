[
  {
    "directory": "${WS}/build",
    "command": "clang++ -I${WS}/include -std=c++20 -Xclang -emit-pch -Xclang -include -Xclang ${WS}/build/CMakeFiles/core.dir/cmake_pch.hxx -x c++-header -o CMakeFiles/core.dir/cmake_pch.hxx.pch -c ${WS}/build/CMakeFiles/core.dir/cmake_pch.hxx.cxx",
    "file": "${WS}/build/CMakeFiles/core.dir/cmake_pch.hxx.cxx",
    "output": "CMakeFiles/core.dir/cmake_pch.hxx.pch"
  },
  {
    "directory": "${WS}/build",
    "command": "clang++ -DBUILD_STATIC -I${WS}/include -std=c++20 -Winvalid-pch -Xclang -include-pch -Xclang ${WS}/build/CMakeFiles/core.dir/cmake_pch.hxx.pch -Xclang -include -Xclang ${WS}/build/CMakeFiles/core.dir/cmake_pch.hxx -o CMakeFiles/tests.dir/main.cpp.o -c ${WS}/main.cpp",
    "file": "${WS}/main.cpp",
    "output": "CMakeFiles/tests.dir/main.cpp.o"
  }
]
