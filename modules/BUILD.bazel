load("@rules_cc//cc:cc_library.bzl", "cc_library")
load(":modules.bzl", "LIBRARIES", "MODULE_COPTS")

# The third-party libraries and the C library as named modules over their
# headers, written by `clice modularize` once for each configuration CI
# builds and merged: third_party.cppm includes the libraries' headers in its
# global module fragment, <configuration>/third_party.fragment.h of the
# configuration whose condition holds, and exports what they declare;
# libc.cppm exports the C library's names the standard library leaves out.
# macros.h replays the macros their headers define, and every unit of clice
# includes it ahead of everything else. scripts/modules.py writes all of it
# from demand.cpp; nothing it writes is edited by hand.

# The fragments, the macro headers and the preludes.
cc_library(
    name = "headers",
    textual_hdrs = glob(["**/*.h"]),
)

cc_library(
    name = "libc",
    copts = MODULE_COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["libc.cppm"],
    deps = [":headers"],
)

cc_library(
    name = "third_party",
    copts = MODULE_COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["third_party.cppm"],
    deps = [
        ":headers",
        "@xclang//bazel:std",
    ] + LIBRARIES,
)

cc_library(
    name = "modules",
    visibility = ["//visibility:public"],
    deps = [
        ":libc",
        ":third_party",
    ],
)

# What clice takes from the libraries, the program scripts/modules.py
# indexes for each configuration to write the rest of modules/.
cc_library(
    name = "demand",
    srcs = ["demand.cpp"],
    copts = MODULE_COPTS,
    tags = ["manual"],
    deps = LIBRARIES,
)
