{
  "name": "clice",
  "displayName": "clice vscode",
  "description": "VSCode extension for clice",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/clice-io/clice"
  },
  "version": "0.1.0",
  "publisher": "clice-io",
  "icon": "clice.png",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "C",
    "C++",
    "cuda",
    "clang"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:cuda-cpp"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "clice compiles and indexes workspace code with Clang, which is not safe to run on untrusted code."
    }
  },
  "contributes": {
    "configurationDefaults": {
      "files.watcherExclude": {
        "**/.clice/**": true
      }
    },
    "configuration": {
      "type": "object",
      "title": "clice",
      "properties": {
        "clice.executable": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path of the clice executable; a relative path resolves against the first workspace folder. Leave empty to use the bundled server."
        },
        "clice.mode": {
          "type": "string",
          "default": "pipe",
          "enum": [
            "pipe",
            "socket"
          ],
          "scope": "machine-overridable",
          "description": "How to communicate with clice. pipe or socket. For daily use please use pipe."
        },
        "clice.host": {
          "type": "string",
          "default": "127.0.0.1",
          "scope": "machine-overridable",
          "description": "The host to connect to in socket mode."
        },
        "clice.port": {
          "type": "integer",
          "default": 50051,
          "minimum": 1,
          "maximum": 65535,
          "scope": "machine-overridable",
          "description": "The port to connect to in socket mode."
        },
        "clice.serverEnv": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "scope": "machine-overridable",
          "markdownDescription": "Environment variables for the clice server and the compilers it asks how they compile, on top of VS Code's own. A value names VS Code's variables as `${env:NAME}`, as `terminal.integrated.env.*` does. A Cygwin or MSYS2 compiler needs its runtime's `bin` directory on `PATH`: `{ \"PATH\": \"C:\\\\cygwin64\\\\bin;${env:PATH}\" }`."
        },
        "clice.trace.server": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "description": "Log the LSP traffic between VS Code and clice to the 'clice (LSP trace)' output channel."
        }
      }
    },
    "commands": [
      {
        "command": "clice.restart",
        "title": "Clice: Restart Language Server"
      },
      {
        "command": "clice.switchConfiguration",
        "title": "Clice: Switch Build Configuration"
      },
      {
        "command": "clice.switchContext",
        "title": "Clice: Switch Compilation Context"
      },
      {
        "command": "clice.showCurrentContext",
        "title": "Clice: Show Current Compilation Context"
      },
      {
        "command": "clice.resetContext",
        "title": "Clice: Use Automatic Compilation Context"
      },
      {
        "command": "clice.queryContexts",
        "title": "Clice: Query Compilation Contexts"
      },
      {
        "command": "clice.refreshContexts",
        "title": "Clice: Refresh Compilation Contexts",
        "icon": "$(refresh)"
      },
      {
        "command": "clice.applyContext",
        "title": "Clice: Apply Compilation Context"
      },
      {
        "command": "clice.loadMoreContexts",
        "title": "Clice: Load More Compilation Contexts"
      },
      {
        "command": "clice.refactor.rewrite.define.inline",
        "title": "Clice: Define Inline"
      },
      {
        "command": "clice.refactor.rewrite.define.outOfLine",
        "title": "Clice: Define Out of Line"
      },
      {
        "command": "clice.refactor.rewrite.define.missing",
        "title": "Clice: Define Missing Members"
      },
      {
        "command": "clice.refactor.rewrite.implementPureVirtuals",
        "title": "Clice: Implement Pure Virtual Methods"
      },
      {
        "command": "clice.refactor.rewrite.generateMemberwiseConstructor",
        "title": "Clice: Generate Memberwise Constructor"
      },
      {
        "command": "clice.refactor.rewrite.populateSwitch",
        "title": "Clice: Add Missing Enum Cases to Switch"
      },
      {
        "command": "clice.refactor.rewrite.expandDeducedType",
        "title": "Clice: Expand Deduced Type"
      },
      {
        "command": "clice.refactor.rewrite.reorderDefinitions",
        "title": "Clice: Reorder Definitions by Declaration Order"
      },
      {
        "command": "clice.refactor.inline.macro",
        "title": "Clice: Expand Macro"
      },
      {
        "command": "clice.switchSourceHeader",
        "title": "Switch Source/Header",
        "category": "Clice"
      },
      {
        "command": "clice.showCompileCommand",
        "title": "Show Compile Command",
        "category": "Clice"
      }
    ],
    "keybindings": [
      {
        "command": "clice.switchSourceHeader",
        "key": "alt+o",
        "when": "editorTextFocus && (editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp)"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "character",
        "description": "C/C++ character literal (e.g., 'a')",
        "superType": "string"
      },
      {
        "id": "escape",
        "description": "Escape sequence inside a string or character literal (e.g., \\n)",
        "superType": "string"
      },
      {
        "id": "formatSpecifier",
        "description": "Placeholder of a format string (e.g., {} in std::format, %d in printf)",
        "superType": "string"
      },
      {
        "id": "primitive",
        "description": "Built-in type (e.g., int, bool)",
        "superType": "keyword"
      },
      {
        "id": "bracket",
        "description": "The < and > of a template argument or parameter list"
      },
      {
        "id": "directive",
        "description": "Preprocessor directive (e.g., #include)",
        "superType": "keyword"
      },
      {
        "id": "header",
        "description": "Header name (e.g., <iostream>)",
        "superType": "string"
      },
      {
        "id": "module",
        "description": "C++20 module name",
        "superType": "namespace"
      },
      {
        "id": "union",
        "description": "Union type",
        "superType": "struct"
      },
      {
        "id": "typeAlias",
        "description": "Typedef or using alias",
        "superType": "type"
      },
      {
        "id": "templateParameter",
        "description": "Non-type template parameter",
        "superType": "parameter"
      },
      {
        "id": "concept",
        "description": "C++20 concept",
        "superType": "type"
      },
      {
        "id": "field",
        "description": "Data member",
        "superType": "property"
      },
      {
        "id": "label",
        "description": "Label (for goto)"
      },
      {
        "id": "macroParameter",
        "description": "Macro parameter",
        "superType": "parameter"
      },
      {
        "id": "attribute",
        "description": "Attribute name (e.g., nodiscard)",
        "superType": "decorator"
      },
      {
        "id": "unknown",
        "description": "Dependent name only an instantiation resolves"
      },
      {
        "id": "conflict",
        "description": "Name meaning entities of different kinds at once"
      },
      {
        "id": "plain",
        "description": "Token without a kind of its own inside an inactive preprocessor region; unstyled, so the editor's syntax coloring shows through"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "definition",
        "description": "The definition of a symbol"
      },
      {
        "id": "defaultLibrary",
        "description": "Declared in a system header or built into the compiler"
      },
      {
        "id": "local",
        "description": "Visible inside a function"
      },
      {
        "id": "member",
        "description": "Visible inside a class"
      },
      {
        "id": "internal",
        "description": "Visible in its own translation unit only"
      },
      {
        "id": "global",
        "description": "Visible from other translation units"
      },
      {
        "id": "template",
        "description": "A template, or a specialization of one"
      },
      {
        "id": "dependent",
        "description": "A name depending on a template parameter"
      },
      {
        "id": "virtual",
        "description": "A virtual function; a class with virtual functions"
      },
      {
        "id": "constexpr",
        "description": "Constant-evaluated: a constexpr or consteval function, a constexpr or constinit variable, a non-type template parameter"
      },
      {
        "id": "constructor",
        "description": "A constructor"
      },
      {
        "id": "destructor",
        "description": "A destructor"
      },
      {
        "id": "callable",
        "description": "A function-like macro; a variable of a callable type"
      },
      {
        "id": "controlFlow",
        "description": "A keyword transferring control; a function that never returns; a macro that returns, breaks, continues, jumps or throws"
      },
      {
        "id": "userDefined",
        "description": "An operator calling an overloaded operator; the suffix of a user-defined literal"
      },
      {
        "id": "declarator",
        "description": "The *, & or && of a declarator"
      },
      {
        "id": "literal",
        "description": "The keywords true, false and nullptr"
      },
      {
        "id": "affix",
        "description": "The encoding prefix or the suffix of a literal"
      },
      {
        "id": "empty",
        "description": "A macro expanding to nothing"
      },
      {
        "id": "inactive",
        "description": "Inside an inactive preprocessor region, or an argument a macro drops. The clice extension dims these regions; other clients can style the modifier directly."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "c",
        "scopes": {
          "keyword": [
            "keyword.other"
          ],
          "struct.global": [
            "entity.name.type.struct"
          ],
          "struct.member": [
            "entity.name.type.struct"
          ],
          "struct.local": [
            "entity.name.type.struct"
          ],
          "struct.internal": [
            "entity.name.type.struct"
          ],
          "keyword.controlFlow": [
            "keyword.control"
          ],
          "keyword.literal": [
            "constant.language"
          ],
          "keyword.documentation": [
            "storage.type.class.doxygen"
          ],
          "primitive": [
            "storage.type.built-in.primitive"
          ],
          "operator.userDefined": [
            "entity.name.function.operator"
          ],
          "operator.declarator": [
            "storage.modifier"
          ],
          "escape": [
            "constant.character.escape"
          ],
          "formatSpecifier": [
            "constant.other.placeholder"
          ],
          "number.affix": [
            "keyword.other.unit.suffix"
          ],
          "number.affix.userDefined": [
            "keyword.other.unit.user-defined"
          ],
          "string.affix": [
            "storage.type.string"
          ],
          "string.affix.userDefined": [
            "keyword.other.unit.user-defined"
          ],
          "character.affix": [
            "storage.type.string"
          ],
          "directive": [
            "keyword.control.directive"
          ],
          "header": [
            "string.quoted.other.lt-gt.include"
          ],
          "bracket": [
            "punctuation.section.angle-brackets"
          ],
          "comment.documentation": [
            "comment.block.documentation"
          ],
          "parameter.documentation": [
            "variable.parameter"
          ],
          "templateParameter": [
            "variable.other.constant"
          ],
          "label": [
            "entity.name.label"
          ],
          "attribute": [
            "entity.other.attribute"
          ],
          "variable.constexpr": [
            "variable.other.constant"
          ]
        }
      },
      {
        "language": "cpp",
        "scopes": {
          "keyword": [
            "keyword.other"
          ],
          "struct.global": [
            "entity.name.type.struct"
          ],
          "struct.member": [
            "entity.name.type.struct"
          ],
          "struct.local": [
            "entity.name.type.struct"
          ],
          "struct.internal": [
            "entity.name.type.struct"
          ],
          "keyword.controlFlow": [
            "keyword.control"
          ],
          "keyword.literal": [
            "constant.language"
          ],
          "keyword.documentation": [
            "storage.type.class.doxygen"
          ],
          "primitive": [
            "storage.type.built-in.primitive"
          ],
          "operator.userDefined": [
            "entity.name.function.operator"
          ],
          "operator.declarator": [
            "storage.modifier"
          ],
          "escape": [
            "constant.character.escape"
          ],
          "formatSpecifier": [
            "constant.other.placeholder"
          ],
          "number.affix": [
            "keyword.other.unit.suffix"
          ],
          "number.affix.userDefined": [
            "keyword.other.unit.user-defined"
          ],
          "string.affix": [
            "storage.type.string"
          ],
          "string.affix.userDefined": [
            "keyword.other.unit.user-defined"
          ],
          "character.affix": [
            "storage.type.string"
          ],
          "directive": [
            "keyword.control.directive"
          ],
          "header": [
            "string.quoted.other.lt-gt.include"
          ],
          "bracket": [
            "punctuation.section.angle-brackets"
          ],
          "comment.documentation": [
            "comment.block.documentation"
          ],
          "parameter.documentation": [
            "variable.parameter"
          ],
          "templateParameter": [
            "variable.other.constant"
          ],
          "label": [
            "entity.name.label"
          ],
          "attribute": [
            "entity.other.attribute"
          ],
          "variable.constexpr": [
            "variable.other.constant"
          ]
        }
      },
      {
        "language": "cuda-cpp",
        "scopes": {
          "keyword": [
            "keyword.other"
          ],
          "struct.global": [
            "entity.name.type.struct"
          ],
          "struct.member": [
            "entity.name.type.struct"
          ],
          "struct.local": [
            "entity.name.type.struct"
          ],
          "struct.internal": [
            "entity.name.type.struct"
          ],
          "keyword.controlFlow": [
            "keyword.control"
          ],
          "keyword.literal": [
            "constant.language"
          ],
          "keyword.documentation": [
            "storage.type.class.doxygen"
          ],
          "primitive": [
            "storage.type.built-in.primitive"
          ],
          "operator.userDefined": [
            "entity.name.function.operator"
          ],
          "operator.declarator": [
            "storage.modifier"
          ],
          "escape": [
            "constant.character.escape"
          ],
          "formatSpecifier": [
            "constant.other.placeholder"
          ],
          "number.affix": [
            "keyword.other.unit.suffix"
          ],
          "number.affix.userDefined": [
            "keyword.other.unit.user-defined"
          ],
          "string.affix": [
            "storage.type.string"
          ],
          "string.affix.userDefined": [
            "keyword.other.unit.user-defined"
          ],
          "character.affix": [
            "storage.type.string"
          ],
          "directive": [
            "keyword.control.directive"
          ],
          "header": [
            "string.quoted.other.lt-gt.include"
          ],
          "bracket": [
            "punctuation.section.angle-brackets"
          ],
          "comment.documentation": [
            "comment.block.documentation"
          ],
          "parameter.documentation": [
            "variable.parameter"
          ],
          "templateParameter": [
            "variable.other.constant"
          ],
          "label": [
            "entity.name.label"
          ],
          "attribute": [
            "entity.other.attribute"
          ],
          "variable.constexpr": [
            "variable.other.constant"
          ]
        }
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "clice.contexts",
          "name": "Compilation Contexts",
          "when": "resourceLangId == c || resourceLangId == cpp || resourceLangId == cuda-cpp"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "clice.applyContext",
          "when": "false"
        },
        {
          "command": "clice.loadMoreContexts",
          "when": "false"
        },
        {
          "command": "clice.refreshContexts",
          "when": "false"
        },
        {
          "command": "clice.switchContext",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp"
        },
        {
          "command": "clice.showCurrentContext",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp"
        },
        {
          "command": "clice.resetContext",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp"
        },
        {
          "command": "clice.queryContexts",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp"
        },
        {
          "command": "clice.refactor.rewrite.define.inline",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp"
        },
        {
          "command": "clice.refactor.rewrite.define.outOfLine",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp"
        },
        {
          "command": "clice.refactor.rewrite.define.missing",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp"
        },
        {
          "command": "clice.refactor.rewrite.implementPureVirtuals",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp"
        },
        {
          "command": "clice.refactor.rewrite.generateMemberwiseConstructor",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp"
        },
        {
          "command": "clice.refactor.rewrite.populateSwitch",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp"
        },
        {
          "command": "clice.refactor.rewrite.expandDeducedType",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp"
        },
        {
          "command": "clice.refactor.rewrite.reorderDefinitions",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp"
        },
        {
          "command": "clice.refactor.inline.macro",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp"
        },
        {
          "command": "clice.switchSourceHeader",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp"
        },
        {
          "command": "clice.showCompileCommand",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp"
        }
      ],
      "editor/context": [
        {
          "command": "clice.switchSourceHeader",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp",
          "group": "navigation@1.9"
        },
        {
          "command": "clice.switchContext",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp",
          "group": "clice@1"
        },
        {
          "command": "clice.showCurrentContext",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp",
          "group": "clice@2"
        }
      ],
      "view/title": [
        {
          "command": "clice.refreshContexts",
          "when": "view == clice.contexts",
          "group": "navigation"
        }
      ]
    }
  },
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "webpack",
    "watch": "webpack --watch",
    "vscode:prepublish": "webpack --mode production --devtool hidden-source-map",
    "package": "vsce package --no-dependencies --baseImagesUrl https://raw.githubusercontent.com/clice-io/clice/main/",
    "publish": "vsce publish --no-dependencies --baseImagesUrl https://raw.githubusercontent.com/clice-io/clice/main/",
    "publish:ovsx": "ovsx publish --no-dependencies --baseImagesUrl https://raw.githubusercontent.com/clice-io/clice/main/",
    "compile-tests": "tsc -p . --outDir out",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "pretest": "npm run compile && npm run compile-tests",
    "test": "vscode-test",
    "release:patch": "npm version patch --no-git-tag-version && npm run release:tag",
    "release:minor": "npm version minor --no-git-tag-version && npm run release:tag",
    "release:tag": "VERSION=$(node -p \"require('./package.json').version\") && git commit -m \"release: v$VERSION\" package.json ../../package-lock.json && git tag \"v$VERSION\" && git push --follow-tags"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~25.0.3",
    "@types/vscode": "^1.82.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.8.0",
    "ovsx": "^1.2.0",
    "ts-loader": "^9.5.4",
    "typescript-eslint": "^8.65.0",
    "typescript": "~5.5.4",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "@clice/tools": "*"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
